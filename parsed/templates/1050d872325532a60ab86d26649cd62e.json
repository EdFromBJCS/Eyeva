{
  "components/account/address-list": "{{#unless customer.addresses}}\n    {{> components/common/alert/alert-info (lang 'account.addresses.no_addresses')}}\n{{/unless}}\n\n<div class=\"eyeva__addressList-container\">\n    <ul class=\"eyeva__addressList\">\n        {{#each customer.addresses}}\n            <li class=\"eyeva__addressList-item\">\n                <div class=\"eyeva__addressList-item-info\">\n                    <h5 class=\"address-title\">{{first_name}} {{last_name}}</h5>\n                    <ul class=\"address-details address-details--postal\">\n                        <li>{{company}}</li>\n                        <li>{{address1}}{{#if address2}}, {{address2}}{{/if}}, {{city}}{{#if state}}, {{state}}{{/if}} {{zip}}, {{country}}</li>\n                    </ul>\n                    {{#if phone}}\n                        <dl class=\"address-details\">\n                            <dt class=\"address-label\">{{lang 'account.addresses.phone' }}</dt>\n                            <dd class=\"address-description\">{{phone}}</dd>\n                        </dl>\n                    {{/if}}\n                </div>\n                <form action=\"{{delete_url}}\" method=\"post\" data-delete-address=\"{{lang 'forms.address.confirm_delete'}}\">\n                    <div class=\"form-actions\">\n                        <a class=\"button button--primary button--small button--icon\" href=\"{{edit_url}}\">\n                            <span class=\"is-srOnly\">{{lang 'common.edit'}}</span>\n                            <i class=\"icon\"><svg class=\"icon\"><use href=\"#icon-pen\"></use></svg></i>\n                        </a>\n                        <button type=\"submit\" class=\"button button--outline button--small button--icon\">\n                            <span class=\"is-srOnly\">{{lang 'common.delete'}}</span>\n                            <i class=\"icon\"><svg class=\"icon\"><use href=\"#icon-trash\"></use></svg></i>\n                        </button>\n                    </div>\n                </form>\n            </li>\n        {{/each}}\n    </ul>\n\n    <p class=\"eyeva__addressList-actions\">\n        <a class=\"button button--primary\" href=\"{{urls.account.add_address}}\">\n            <i class=\"icon icon--left\"><svg><use href=\"#icon-plus\"></use></svg></i>\n            {{lang 'account.addresses.new_address'}}\n        </a>\n    </p>\n</div>\n",
  "components/common/alert/alert-info": "<div class=\"alertBox alertBox--info\" data-promotion-banner>\n    <div class=\"alertBox-column alertBox-icon\">\n        <icon glyph=\"ic-success\" class=\"icon\" aria-hidden=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z\"></path></svg></icon>\n    </div>\n    <p class=\"alertBox-column alertBox-message\">\n        <span>{{{this}}}</span>\n    </p>\n</div>\n"
}