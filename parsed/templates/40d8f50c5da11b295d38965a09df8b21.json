{
  "components/common/body": "<div class=\"body\" id=\"main-content\" data-currency-code=\"{{currency_selector.active_currency_code}}\">\n    {{#block \"hero\"}} {{/block}}\n    <div class=\"container\">\n        {{#block \"page\"}} {{/block}}\n    </div>\n    {{#block \"page-bottom\"}} {{/block}}\n    {{> components/common/modal/modal}}\n    {{> components/common/alert/alert-modal}}\n</div>\n",
  "components/common/modal/modal": "<div id=\"modal\" class=\"modal\" data-reveal data-prevent-quick-search-close>\n    {{> components/common/modal/modal-close-btn}}\n    <div id=\"modal-content\" class=\"modal-content\"></div>\n    <div class=\"loadingOverlay\"></div>\n</div>\n\n<div id=\"previewModal\" class=\"modal modal--large\" data-reveal>\n    {{> components/common/modal/modal-close-btn }}\n    <div class=\"modal-content\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"modal-header-title\"></div>\n    <div class=\"loadingOverlay\"></div>\n</div>\n\n{{> components/papathemes/create-wishlist-modal}}\n\n{{#if settings.show_wishlist}}\n    <script type=\"text/x-template\" id=\"cardWishlistTemplate\" nonce=\"{{nonce}}\">\n        {{> components/products/card-wishlist-dropdown id=\"%%PRODUCT_ID%%\" name=\"%%PRODUCT_NAME%%\"}}\n    </script>\n{{/if}}\n\n<script type=\"text/x-template\" id=\"quickSearchModalTemplate\"\n    data-modal-title=\"{{lang 'search.quick_search.header' name=settings.store_name}}\"\n    nonce=\"{{nonce}}\"\n>\n    {{> components/common/quick-search name='nav-quick-search'}}\n</script>\n",
  "components/common/alert/alert-modal": "<div id=\"alert-modal\" class=\"modal modal--alert modal--small\" data-reveal data-prevent-quick-search-close>\n    <div class=\"alert-icon error-icon\">\n        <span class=\"icon-content\">\n            <span class=\"line line-left\"></span>\n            <span class=\"line line-right\"></span>\n        </span>\n    </div>\n\n    <div class=\"alert-icon warning-icon\">\n        <div class=\"icon-content\">!</div>\n    </div>\n\n    <div class=\"modal-content\"></div>\n\n    <div class=\"button-container\">\n        <button type=\"button\" class=\"confirm button\" data-reveal-close>{{lang 'common.ok'}}</button>\n        <button type=\"button\" class=\"cancel button\" data-reveal-close>{{lang 'common.cancel'}}</button>\n    </div>\n</div>\n",
  "components/common/modal/modal-close-btn": "<button class=\"modal-close\"\n        type=\"button\"\n        title=\"{{lang 'common.close'}}\"\n        {{additional_attr}}\n>\n    <span class=\"aria-description--hidden\">{{lang 'common.close'}}</span>\n    <span aria-hidden=\"true\">&#215;</span>\n</button>\n",
  "components/papathemes/create-wishlist-modal": "<div id=\"creatingWishlistModalContent\" style=\"display:none\">\n    <form action=\"{{urls.account.wishlists.add}}\" class=\"form\" method=\"post\">\n        <div class=\"form-field\">\n            <label class=\"form-label\" for=\"creatingWishlistModalContent_wishlistname\">\n                {{lang 'forms.wishlist.name'}}\n                <small>{{lang 'common.required' }}</small>\n            </label>\n            <input class=\"form-input\" name=\"wishlistname\" id=\"creatingWishlistModalContent_wishlistname\" value=\"\" required>\n        </div>\n        <div class=\"form-field\">\n            <input type=\"checkbox\" class=\"form-checkbox\" name=\"publicwishlist\" id=\"creatingWishlistModalContent_publicwishlist\">\n            <label class=\"form-label\" for=\"creatingWishlistModalContent_publicwishlist\">{{lang 'forms.wishlist.public'}}</label>\n\n        </div>\n        <div class=\"form-actions\">\n            <input type=\"submit\" class=\"button button--primary\" value=\"{{lang 'account.wishlists.create'}}\">\n        </div>\n    </form>\n</div>\n",
  "components/common/quick-search": "<div class=\"container\">\n    <form class=\"form form--quickSearch\" onsubmit=\"return false\" data-url=\"{{urls.search}}\" data-quick-search-form>\n        <fieldset class=\"form-fieldset\">\n            <div class=\"form-field\">\n                <label class=\"is-srOnly\" for=\"{{name}}\">{{lang \"search.quick_search.input_label\"}}</label>\n                <input class=\"form-input\"\n                       data-search-quick\n                       name=\"{{name}}\"\n                       id=\"{{name}}\"\n                       data-error-message=\"{{lang 'search.error.empty_field'}}\"\n                       placeholder=\"{{lang 'search.quick_search.input_placeholder'}}\"\n                       autocomplete=\"off\"\n                >\n                <button type=\"submit\" class=\"button button--plain button--icon\">\n                    <i class=\"icon\" aria-hidden=\"true\"><svg><use href=\"#icon-search\"></use></svg></i>\n                    <span class=\"is-srOnly\">{{lang 'common.search'}}</span>\n                </button>\n            </div>\n        </fieldset>\n    </form>\n    <section class=\"quickSearchResults\" data-bind=\"html: results\"></section>\n    <p role=\"status\"\n       aria-live=\"polite\"\n       class=\"aria-description--hidden\"\n       data-search-aria-message-predefined-text=\"{{{lang 'search.results.quick_count_live'}}}\"\n    ></p>\n</div>\n",
  "components/products/card-wishlist-dropdown": "<div class=\"card-wishlist\">\n    <form action=\"/wishlist.php?action=add&product_id={{id}}\" class=\"form form-wishlist form-action\" data-wishlist-add=\"{{id}}\" method=\"post\" data-product-name=\"{{name}}\">\n        {{#if customer}}\n            <a aria-controls=\"eyeva__wishlist-dropdown-{{id}}-{{incrementVar 'cardWishListUID'}}\"\n                aria-expanded=\"false\"\n                class=\"card-figcaption-button _wishlist\"\n                data-dropdown=\"eyeva__wishlist-dropdown-{{id}}-{{getVar 'cardWishListUID'}}\"\n                data-wishlist-add-customer\n                href=\"#eyeva__wishlist-dropdown-{{id}}-{{getVar 'cardWishListUID'}}\"\n            >\n                <span class=\"is-srOnly\">{{lang 'account.wishlists.add_item'}}</span>\n                <i aria-hidden=\"true\" class=\"icon\"><svg><use href=\"#icon-heart\" /></svg></i>\n            </a>\n            <ul aria-hidden=\"true\" class=\"wishlist-dropdown-menu _card\" data-dropdown-content data-dropdown-align=\"left\" id=\"eyeva__wishlist-dropdown-{{id}}-{{getVar 'cardWishListUID'}}\" data-wishlist-dropdown>\n                {{#if customer.wishlists}}\n                    {{#each customer.wishlists}}\n                        <li>\n                            <button class=\"_action {{#if this.num_items '!==' '0'}}_has-items{{/if}}\"\n                                formaction=\"{{this.add_url}}&product_id={{../id}}\"\n                                type=\"submit\"\n                                data-wishlist-id=\"{{this.id}}\"\n                            >\n                                {{this.name}}\n                                <i aria-hidden=\"true\" class=\"icon _on\"><svg><use href=\"#icon-check\" /></svg></i>\n                            </button>\n                        </li>\n                    {{/each}}\n                {{else}}\n                    <li data-wishlist-add-to-default>\n                        <input class=\"_action\" type=\"submit\" value=\"{{lang 'account.wishlists.add_to_default'}}\">\n                    </li>\n                {{/if}}\n                <li>\n                    <a data-wishlist-create class=\"_action\" href=\"/wishlist.php?action=addwishlist&product_id={{id}}\">{{lang 'account.wishlists.create_new'}}</a>\n                </li>\n            </ul>\n        {{else}}\n            <button type=\"button\" class=\"card-figcaption-button _wishlist\" data-wishlist-add-anonymous>\n                <span class=\"is-srOnly\">{{lang 'account.wishlists.add_item'}}</span>\n                <i aria-hidden=\"true\" class=\"icon\"><svg><use href=\"#icon-heart\" /></svg></i>\n            </button>\n        {{/if}}\n    </form>\n</div>\n"
}