p>\r\n                        </div>\r\n                    </a>\r\n                    <a href=\"https://www.bobjohnson.com/blog/tag/Buying-Guide\">\r\n                        <div class=\"icon-item\">\r\n                            <div class=\"heroBannerIcon\"><img\r\n                                    src=\"https://cdn11.bigcommerce.com/s-8lxh1/images/stencil/original/image-manager/guide.png?t=1766596941\"\r\n                                    alt=\"Buyers Guide\" /></div>\r\n                            <h3 class=\"icon-heading\">Buyers Guides</h3>\r\n                            <p class=\"icon-description\">Our blog provides detailed reviews on the rugged computers we\r\n                                sell.\r\n                            </p>\r\n                        </div>\r\n                    </a>\r\n                    <a href=\"https://www.bobjohnson.com/rugged-computer-selection-assistance/\">\r\n                        <div class=\"icon-item\">\r\n                            <div class=\"heroBannerIcon\"><img\r\n                                    src=\"https://cdn11.bigcommerce.com/s-8lxh1/images/stencil/original/image-manager/warranty.png?t=1766596862\"\r\n                                    alt=\"Selection Assistance\" /></div>\r\n                            <h3 class=\"icon-heading\">Selection Assistance</h3>\r\n                            <p class=\"icon-description\">Fill out our form and we'll help you find the perfect option for\r\n                                you!\r\n                            </p>\r\n                        </div>\r\n                    </a>\r\n                    <a href=\"https://www.bobjohnson.com/testimonials/\">\r\n                        <div class=\"icon-item\">\r\n                            <div class=\"heroBannerIcon\"><img\r\n                                    src=\"https://cdn11.bigcommerce.com/s-8lxh1/images/stencil/original/image-manager/money.png?t=1766596883\"\r\n                                    alt=\"Testimonials\" /></div>\r\n                            <h3 class=\"icon-heading\">Testimonials</h3>\r\n                            <p class=\"icon-description\">See what our customers have said!</p>\r\n                        </div>\r\n                    </a>\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <button class=\"homeblaze-next\" onclick=\"nextSlide()\">\r\n            <svg class=\"icon\">\r\n                <use xlink:href=\"#icon-arrow-right-long\"></use>\r\n            </svg>\r\n        </button>\r\n    </div>\r\n\r\n    <div class=\"repair-container desktop-repair\">\r\n        <a class=\"card-link\" href=\"https://www.bobjohnson.com/repairs-service/?tab=0\">\r\n            <img class=\"home-repair-img\"\r\n                src=\"https://cdn11.bigcommerce.com/s-8lxh1/images/stencil/original/image-manager/repairservices-gearcross-1.png?t=1766596980\"\r\n                alt=\"Repair Services\" class=\"rugged-rundown-btn\" />\r\n            <h3>Full Service Rugged Computer Repair</h3>\r\n            <p>Industry leading rugged Dell, Durabook, Getac, and Panasonic rugged computers.</p>\r\n            <ul>\r\n                <li><img src=\"https://www.bobjohnson.com/product_images/uploaded_images/cost-red.png\" alt=\"Repair Cost\" class=\"nav-icon\" />\r\n                    $150 repair fee + part pricing\r\n                </li>\r\n                <li><img src=\"https://www.bobjohnson.com/product_images/uploaded_images/turn-around-red.png\" alt=\"Turn Around\" class=\"nav-icon\" />\r\n                    2-4 Week Turnaround\r\n                </li>\r\n            </ul>\r\n        </a>\r\n        <a class=\"button button--primary\" href=\"https://www.bobjohnson.com/repairs-service/?tab=0\">Fill Out Our Repair Form</a>\r\n    </div>\r\n</div>\r\n\r\n<script>\r\n    const carousel = document.getElementById('carousel');\r\n    let slides = document.querySelectorAll('.slide');\r\n\r\n    // Clone first slide and append it\r\n    const firstClone = slides[0].cloneNode(true);\r\n    carousel.appendChild(firstClone);\r\n\r\n    slides = document.querySelectorAll('.slide'); // refresh list\r\n    const totalSlides = slides.length;\r\n\r\n    let currentSlide = 0;\r\n    let slideWidth = 100;\r\n\r\n    function moveToSlide(index) {\r\n        carousel.style.transition = 'transform 0.5s ease';\r\n        carousel.style.transform = `translateX(-${index * slideWidth}%)`;\r\n    }\r\n\r\n    function nextSlide() {\r\n        currentSlide++;\r\n        moveToSlide(currentSlide);\r\n\r\n        // If we're on the clone, reset to real first slide\r\n        if (currentSlide === totalSlides - 1) {\r\n            setTimeout(() => {\r\n                carousel.style.transition = 'none';\r\n                currentSlide = 0;\r\n                carousel.style.transform = `translateX(0%)`;\r\n            }, 500);\r\n        }\r\n    }\r\n\r\n    function prevSlide() {\r\n        if (currentSlide === 0) {\r\n            // Jump instantly to clone (last slide)\r\n            carousel.style.transition = 'none';\r\n            currentSlide = totalSlides - 1;\r\n            carousel.style.transform = `translateX(-${currentSlide * slideWidth}%)`;\r\n\r\n            requestAnimationFrame(() => {\r\n                requestAnimationFrame(() => {\r\n                    carousel.style.transition = 'transform 0.5s ease';\r\n                    currentSlide--;\r\n                    carousel.style.transform = `translateX(-${currentSlide * slideWidth}%)`;\r\n                });\r\n            });\r\n        } else {\r\n            currentSlide--;\r\n            moveToSlide(currentSlide);\r\n        }\r\n    }\r\n\r\n    // Autoplay (always moves left)\r\n    setInterval(nextSlide, 5000);\r\n\r\n    // Init\r\n    moveToSlide(0);\r\n</script>"
}