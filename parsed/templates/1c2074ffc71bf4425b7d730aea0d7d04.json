{
  "components/search/page-sidebar": "<aside class=\"plp-page-sidebar {{#if forms.search.section '!=' 'product'}} u-hiddenVisually{{/if}}\" id=\"page-sidebar\">\n    <div class=\"plp-page-sidebar-modal\">\n        <button class=\"plp-page-sidebar-modal-close\" type=\"button\" title=\"{{lang 'common.close'}}\" data-collapsible=\"page-sidebar\">\n            <span class=\"aria-description--hidden\">{{lang 'common.close'}}</span>\n            <span class=\"icon\" aria-hidden=\"true\">\n                <svg><use href=\"#icon-xmark-large\"></use></svg>\n            </span>\n        </button>\n        <div class=\"plp-page-sidebar-modal-header\">\n            {{#if product_results.faceted_search_enabled}}\n                {{lang 'search.faceted.filters'}}\n            {{else}}\n                {{lang 'forms.search.title'}}\n            {{/if}}\n        </div>\n        <div class=\"faceted-search-container\" id=\"faceted-search-container\">\n            {{#if product_results.faceted_search_enabled}}\n                {{> components/search/sidebar}}\n            {{else}}\n                {{> components/search/advanced-search}}\n            {{/if}}\n        </div>\n    </div>\n</aside>\n",
  "components/search/sidebar": "<nav class=\"faceted-search-container-nav\">\n    {{#if product_results.faceted_search_enabled}}\n        {{> components/faceted-search/index product_results theme_settings=theme_settings}}\n\n        <div class=\"faceted-search-container-nav-footer\">\n            {{#if product_results.selected.remove_all_url}}\n                    <a href=\"{{product_results.selected.remove_all_url}}\" class=\"button button--outline\" data-faceted-search-facet id=\"faceted-search-clear-all-close-sidebar\">\n                        {{lang 'search.faceted.selected.clear-all'}}\n                    </a>\n                </li>\n            {{/if}}\n            <button class=\"button button--primary\" type=\"button\" title=\"{{lang 'common.close'}}\" data-collapsible=\"page-sidebar\">\n                {{lang 'search.results.view_product_count' count=pagination.product_results.total}}\n            </button>\n        </div>\n    {{/if}}\n</nav>\n",
  "components/search/advanced-search": "<div class=\"accordion accordion--navList\">\n    <div class=\"accordion-block accordion-block--advancedSearch\">\n        <h5 class=\"accordion-heading\">\n            <button type=\"button\" class=\"accordion-navigation\" data-collapsible=\"advanced-search-content\" aria-label=\"{{lang 'forms.search.title'}}\" aria-controls=\"advanced-search-content\" aria-expanded=\"false\">\n                <span class=\"_title\">{{lang 'forms.search.title'}}</span>\n                <span class=\"icon\"><svg class=\"icon-chevron-down\"><use href=\"#icon-chevron-down\"></use></svg></span>\n            </button>\n        </h5>\n        <div id=\"advanced-search-content\" class=\"accordion-content\" aria-hidden=\"true\">\n            <form class=\"advancedSearch-form\" action=\"{{forms.search.action}}\" data-advanced-search-form>\n                <input type=\"hidden\" name=\"mode\" value=\"1\">\n                <fieldset class=\"form-fieldset\">\n                    <div class=\"form-field\">\n                        <label class=\"form-label\" for=\"search_query_adv\">\n                            {{lang 'forms.search.query' }}\n                            <small>{{lang 'common.required' }}</small>\n                        </label>\n                        <input type=\"text\" class=\"form-input\" name=\"search_query_adv\" data-error-message=\"{{lang 'search.error.empty_field'}}\" id=\"search_query_adv\" value=\"{{forms.search.query}}\">\n                    </div>\n\n                    <div class=\"form-field\">\n                        <label class=\"form-label\" for=\"search-form-brand\">\n                            {{lang 'forms.search.brand' }}\n                        </label>\n                        <select class=\"form-select\" name=\"brand\" id=\"search-form-brand\">\n                            <option value=\"\">{{lang 'common.no_preference'}}</option>\n                            {{#each forms.search.brands_list}}\n                                <option value=\"{{id}}\" {{#if ../forms.search.values.brand '==' id}}selected{{/if}}>{{name}}</option>\n                            {{/each}}\n                        </select>\n                    </div>\n                </fieldset>\n                <fieldset class=\"form-fieldset\">\n                    <div class=\"form-field\">\n                        <label class=\"form-label\">\n                            {{lang 'forms.search.categories' }}\n                        </label>\n                        <div class=\"form-field-group\" data-search-category-tree></div>\n                    </div>\n                    <div class=\"form-field\">\n                        <input type=\"checkbox\" class=\"form-checkbox\" name=\"searchsubs\" value=\"ON\" id=\"search-form-searchsubs\" checked>\n                        <label class=\"form-label\" for=\"search-form-searchsubs\">{{lang 'forms.search.searchsubs'}}</label>\n                    </div>\n                </fieldset>\n                <div class=\"form-field search-price-range\">\n                    <h5 class=\"advancedSearch-title\">{{lang 'forms.search.by_price'}}</h5>\n                    <p class=\"form-label\" for=\"search-form-price_from\">\n                        {{lang 'forms.search.price_range' }}\n                    </p>\n                    <label>\n                        <span class=\"is-srOnly\">{{lang 'forms.search.price_range' }}</span>\n                        <span>{{lang 'common.from'}}</span><input type=\"number\" step=\"any\" class=\"form-input\" name=\"price_from\" id=\"search-form-price_from\" value=\"{{forms.search.values.price_from}}\">\n                    </label>\n                    <label>\n                        <span class=\"is-srOnly\">{{lang 'forms.search.price_range' }}</span>\n                        <span>{{lang 'common.to'}}</span><input type=\"number\" step=\"any\" class=\"form-input\" name=\"price_to\" id=\"search-form-price_to\" value=\"{{forms.search.values.price_to}}\">\n                    </label>\n                </div>\n                <h5 class=\"advancedSearch-title\">{{lang 'forms.search.by_setting'}}</h5>\n                <div class=\"form-field\">\n                    <label class=\"form-label\" for=\"search-form-featured\">\n                        {{lang 'forms.search.featured_products.title' }}\n                    </label>\n                    <select class=\"form-select\" name=\"featured\" id=\"search-form-featured\">\n                        <option value=\"\">{{lang 'common.no_preference'}}</option>\n                        <option value=\"1\" {{#if forms.search.values.featured_products '===' '1'}}selected{{/if}}>{{lang 'forms.search.featured_products.enabled' }}</option>\n                        <option value=\"2\" {{#if forms.search.values.featured_products '===' '2'}}selected{{/if}}>{{lang 'forms.search.featured_products.disabled' }}</option>\n                    </select>\n                </div>\n                <div class=\"form-field\">\n                    <label class=\"form-label\" for=\"search-form-shipping\">\n                        {{lang 'forms.search.free_shipping.title' }}\n                    </label>\n                    <select class=\"form-select\" name=\"shipping\" id=\"search-form-shipping\">\n                        <option value=\"\">{{lang 'common.no_preference'}}</option>\n                        <option value=\"1\" {{#if forms.search.values.free_shipping '===' '1'}}selected{{/if}}>{{lang 'forms.search.free_shipping.free' }}</option>\n                        <option value=\"2\" {{#if forms.search.values.free_shipping '===' '2'}}selected{{/if}}>{{lang 'forms.search.free_shipping.paid' }}</option>\n                    </select>\n                </div>\n                <div class=\"faceted-search-container-nav-footer\">\n                    <input\n                            id=\"advanced-search-submit\"\n                            class=\"button button--primary\"\n                            type=\"submit\"\n                            value=\"{{lang 'forms.search.search' }}\">\n                </div>\n            </form>\n        </div>\n    </div>\n</div>\n",
  "components/faceted-search/index": "{{> components/eyeva/faceted-search/init-image-color}}\n<div id=\"facetedSearch\" class=\"facetedSearch\" role=\"region\" aria-label=\"{{lang 'search.faceted.label'}}\">\n    {{#any facets visible=true}}\n        <div id=\"facetedSearch-navList\"\n            class=\"facetedSearch-navList\"\n        >\n            <div class=\"accordion accordion--navList\">\n                {{#each facets}}\n                    {{#if visible}}\n                        {{#inArray ../theme_settings.facet_img_arr (lowercase facet)}}\n                            {{#if (merge this isFacetImg=true)}}{{/if}}\n                        {{/inArray}}\n                        {{#inArray ../theme_settings.facet_color_arr (lowercase facet)}}\n                            {{#if (merge this isFacetColor=true)}}{{/if}}\n                        {{/inArray}}\n                        {{{dynamicComponent 'components/faceted-search/facets'}}}\n                    {{/if}}\n                {{/each}}\n            </div>\n\n            <div class=\"blocker\" style=\"display: none;\"></div>\n        </div>\n    {{/any}}\n</div>\n",
  "components/faceted-search/facets/hierarchy-children": "<ul class=\"navList navList--inner\">\n    {{#each this}}\n        <li class=\"navList-item\">\n            <a\n            href=\"{{url}}\"\n            class=\"navList-action navList-action--checkbox{{#if selected}} is-selected{{/if}}{{#if has_sub_categories}} has-children{{/if}}\"\n            rel=\"nofollow\"\n            data-id=\"{{id}}\"\n            data-faceted-search-facet>\n                {{{sanitize title}}}\n                {{#if ../show_product_counts}}\n                    {{#if count}}\n                        <span>({{count}})</span>\n                    {{/if}}\n                {{/if}}\n            </a>\n            {{#if children}}\n                {{> components/faceted-search/facets/hierarchy-children children}}\n            {{/if}}\n        </li>\n    {{/each}}\n</ul>\n",
  "components/faceted-search/facets/range": "<div class=\"accordion-block\">\n    {{> components/faceted-search/faceted-search-navigation}}\n\n    <div id=\"facetedSearch-content--{{dashcase facet}}\" class=\"accordion-content {{#if selected}} is-open{{/if}}\">\n        {{> components/faceted-search/range-form}}\n    </div>\n</div>\n",
  "components/faceted-search/facets/rating": "{{#if items}}\n<div class=\"accordion-block\">\n    {{> components/faceted-search/faceted-search-navigation}}\n\n    <div id=\"facetedSearch-content--{{dashcase facet}}\" class=\"accordion-content facetedSearch-content--{{dashcase facet}} {{#if selected}} is-open{{/if}}\">\n        <ul class=\"eyeva__faceted-list _flex\">\n            {{#each items}}\n                <li class=\"eyeva__faceted-list-item\">\n                    <a href=\"{{url}}\"\n                       class=\"eyeva__faceted-list-action{{#if selected}} is-selected{{/if}}\"\n                       rel=\"nofollow\"\n                       data-faceted-search-facet>\n                        <span class=\"rating--small\">\n                            {{> components/products/ratings-mini rating=(concat title '+')}}\n                        </span>\n                        {{#if ../show_product_counts}}\n                            <span class=\"_count\">({{count}})</span>\n                        {{/if}}\n                    </a>\n                </li>\n            {{/each}}\n        </ul>\n    </div>\n</div>\n{{/if}}\n",
  "components/faceted-search/facets/hierarchy": "{{#if items}}\n<div class=\"accordion-block\">\n    {{> components/faceted-search/faceted-search-navigation}}\n\n    <div id=\"facetedSearch-content--{{dashcase facet}}\" class=\"accordion-content {{#if selected}} is-open{{/if}}\">\n        <ul id=\"facetedSearch-navList--{{dashcase facet}}\" class=\"navList\" data-facet=\"{{facet}}\" data-has-more-results=\"{{has_more_results}}\">\n            {{#each items}}\n                <li class=\"navList-item\">\n                    <a\n                        href=\"{{url}}\"\n                        class=\"navList-action navList-action--checkbox{{#if selected }} is-selected{{/if}}{{#if has_sub_categories}} has-children{{/if}}\"\n                        rel=\"nofollow\"\n                        data-id=\"{{id}}\"\n                        data-faceted-search-facet>\n                        {{{sanitize title}}}\n                        {{#if ../show_product_counts}}\n                            <span>({{count}})</span>\n                        {{/if}}\n                    </a>\n                    {{#if children}}\n                        {{> components/faceted-search/facets/hierarchy-children children}}\n                    {{/if}}\n                </li>\n            {{/each}}\n        </ul>\n\n        {{#if show_more_toggle}}\n            <a href=\"#facetedSearch-navList--{{dashcase facet}}\" role=\"button\" class=\"toggleLink\">\n                <span class=\"toggleLink-text toggleLink-text--off\">{{lang 'search.faceted.show-more'}}</span>\n            </a>\n        {{/if}}\n    </div>\n</div>\n{{/if}}\n",
  "components/eyeva/faceted-search/init-image-color": "{{#if theme_settings}}\n    {{assignVar 'facet_img_size_width' (toInt (first (split theme_settings.facet_img_size 'x')))}}\n    {{assignVar 'facet_color_size_width' (toInt (first (split theme_settings.facet_color_size 'x')))}}\n\n    {{assignVar '_tmp' \" \"}}\n    {{#each (split (lowercase theme_settings.facet_img) ',')}}\n        {{assignVar '_tmp' (get 'string' (multiConcat (getVar '_tmp') ',' (trim this)))}}\n    {{/each}}\n    {{#all (getVar '_tmp') (merge theme_settings facet_img_arr=(split (getVar '_tmp') ','))}}\n    {{/all}}\n\n    {{assignVar '_tmp' \" \"}}\n    {{#each (split (lowercase theme_settings.facet_color) ',')}}\n        {{assignVar '_tmp' (get 'string' (multiConcat (getVar '_tmp') ',' (trim this)))}}\n    {{/each}}\n    {{#all (getVar '_tmp') (merge theme_settings facet_color_arr=(split (getVar '_tmp') ','))}}\n    {{/all}}\n{{/if}}\n",
  "components/faceted-search/facets/multi": "{{#if items}}\n<div class=\"accordion-block\">\n    {{> components/faceted-search/faceted-search-navigation}}\n\n    <div id=\"facetedSearch-content--{{dashcase facet}}\" class=\"accordion-content {{#if selected}} is-open{{/if}}\">\n\n        {{#if type '===' 'bool'}}\n            <ul id=\"facetedSearch-navList--{{dashcase facet}}\" data-facet=\"{{facet}}\" data-facet-key=\"{{dashcase facet}}\" class=\"navList\" data-has-more-results=\"{{has_more_results}}\">\n                {{#each items}}\n                    <li class=\"navList-item\">\n                        <a\n                            href=\"{{url}}\"\n                            class=\"navList-action navList-action--checkbox{{#if selected}} is-selected{{/if}}\"\n                            rel=\"nofollow\"\n                            data-id=\"{{id}}\"\n                            data-faceted-search-facet>\n                            {{{sanitize title}}}\n                            {{#if ../show_product_counts}}\n                                <span class=\"_count\">({{count}})</span>\n                            {{/if}}\n\n                            <span class=\"navList-action-close\" aria-hidden=\"true\">\n                                <svg class=\"icon\">\n                                    <use href=\"#icon-close\"/>\n                                </svg>\n                            </span>\n                        </a>\n                    </li>\n                {{/each}}\n            </ul>\n        {{else}}\n            <ul id=\"facetedSearch-navList--{{dashcase facet}}\" data-facet=\"{{facet}}\" class=\"eyeva__faceted-list\" data-has-more-results=\"{{has_more_results}}\">\n                {{#each items}}\n                    <li class=\"eyeva__faceted-list-item\">\n                        <a\n                            href=\"{{url}}\"\n                            class=\"eyeva__faceted-list-action{{#if selected}} is-selected{{/if}}\"\n                            rel=\"nofollow\"\n                            data-id=\"{{id}}\"\n                            data-faceted-search-facet>\n                            {{#if ../isFacetImg}}\n                                <span class=\"_img\" data-faceted-search-facet-image>\n                                    <img\n                                        src=\"data:image/gif;base64,R0lGODlhAQABAIAAAP///wAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw==\"\n                                        data-src=\"{{getImageManagerImage (multiConcat (dashcase ../facet) '-' (dashcase id) '.png') width=(getVar 'facet_img_size_width')}}\"\n                                        data-srcset=\"{{getImageManagerImageSrcset (multiConcat (dashcase ../facet) '-' (dashcase id) '.png')}}\"\n                                        data-sizes=\"auto\"\n                                        alt=\"{{{sanitize title}}}\">\n                                </span>\n                            {{else if ../isFacetColor}}\n                                <span class=\"_color\" data-faceted-search-facet-color>\n                                    <img\n                                        src=\"data:image/gif;base64,R0lGODlhAQABAIAAAP///wAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw==\"\n                                        data-src=\"{{getImageManagerImage (multiConcat (dashcase ../facet) '-' (dashcase id) '.png') width=(getVar 'facet_color_size_width')}}\"\n                                        data-srcset=\"{{getImageManagerImageSrcset (multiConcat (dashcase ../facet) '-' (dashcase id) '.png')}}\"\n                                        data-sizes=\"auto\"\n                                        alt=\"{{{sanitize title}}}\">\n                                </span>\n                            {{/if}}\n                            <span class=\"_text\">{{{sanitize title}}}</span>\n                            {{#if ../show_product_counts}}\n                                <span class=\"_count\">({{count}})</span>\n                            {{/if}}\n                        </a>\n                    </li>\n                {{/each}}\n            </ul>\n        {{/if}}\n\n        {{#if show_more_toggle}}\n            <a href=\"#facetedSearch-navList--{{dashcase facet}}\" role=\"button\" class=\"toggleLink\">\n                <span class=\"toggleLink-text toggleLink-text--off\">{{lang 'search.faceted.show-more'}}</span>\n                <span class=\"toggleLink-text toggleLink-text--on\">{{lang 'search.faceted.show-less'}}</span>\n            </a>\n        {{/if}}\n    </div>\n</div>\n{{/if}}\n",
  "components/faceted-search/range-form": "<form id=\"facet-range-form\" class=\"form\" method=\"get\" data-faceted-search-range novalidate>\n    <input type=\"hidden\" name=\"search_query\" value=\"{{search_query}}\">\n    {{#if this.sort}}\n        <input type=\"hidden\" name=\"sort\" value=\"{{this.sort}}\">\n    {{/if}}\n    <fieldset class=\"form-fieldset\">\n        <div class=\"form-minMaxRow\">\n            <div class=\"form-field\">\n                <input\n                    name=\"{{#if shop_by_price}}price_min{{else}}min_price{{/if}}\"\n                    placeholder=\"{{lang 'search.faceted.range.min-placeholder'}}\"\n                    min=\"0\"\n                    class=\"form-input form-input--small\"\n                    required\n                    type=\"number\"\n                    value=\"{{min_price}}\"\n                    aria-label=\"{{lang 'search.faceted.range.min-placeholder'}}\"\n                    aria-describedby=\"min_price_description\"\n                />\n                <span id=\"min_price_description\" class=\"aria-description--hidden\">{{lang 'search.faceted.range.min-description'}}</span>\n            </div>\n\n            <div class=\"form-field\">\n                <input\n                    name=\"{{#if shop_by_price}}price_max{{else}}max_price{{/if}}\"\n                    placeholder=\"{{lang 'search.faceted.range.max-placeholder'}}\"\n                    min=\"0\"\n                    class=\"form-input form-input--small\"\n                    required\n                    type=\"number\"\n                    value=\"{{max_price}}\"\n                    aria-label=\"{{lang 'search.faceted.range.max-placeholder'}}\"\n                    aria-describedby=\"max_price_description\"\n                />\n                <span id=\"max_price_description\" class=\"aria-description--hidden\">{{lang 'search.faceted.range.max-description'}}</span>\n            </div>\n\n            <div class=\"form-field\">\n                <button class=\"button button--small\" type=\"submit\">\n                    {{lang 'search.faceted.range.update'}}\n                </button>\n            </div>\n        </div>\n\n        <div class=\"form-inlineMessage\" aria-live=\"polite\" role=\"alert\"></div>\n    </fieldset>\n</form>\n",
  "components/products/ratings-mini": "<span role=\"img\"\n    class=\"stars\"\n    {{#if rating_target}}\n      aria-label=\"{{lang 'products.reviews.rating_aria_label' rating_target=rating_target current_rating=rating max_rating=5}}\"\n    {{else}}\n      aria-label=\"{{lang 'products.reviews.rating_aria_label' rating_target='Product' current_rating=rating max_rating=5}}\"\n    {{/if}}\n>\n    <span class=\"icon icon--ratingFull\">\n        <svg>\n            <use href=\"#icon-star\" />\n        </svg>\n    </span>\n    {{rating}}\n</span>\n",
  "components/faceted-search/faceted-search-navigation": "<h2 class=\"accordion-heading accordion-nav-clear-holder\">\n        <button type=\"button\"\n            class=\"accordion-navigation {{#if selected}} is-open{{/if}}\"\n         data-collapsible=\"#facetedSearch-content--{{dashcase facet}}\"\n         aria-label=\"{{lang 'search.faceted.toggleSection' title=title}}\"\n    >\n        <span class=\"_title\">\n            {{title}}\n        </span>\n\n        {{#if selected}}\n            <span class=\"_count\">1</span>\n        {{/if}}\n\n        <span class=\"icon\"><svg><use href=\"#icon-chevron-down\" /></svg></span>\n    </button>\n    {{#if selected}}\n        <a href=\"{{remove_url}}\" class=\"facetedSearch-clearLink\" data-faceted-search-facet>\n            <span class=\"is-srOnly\">{{lang 'search.faceted.clear'}}</span>\n            <span class=\"icon\"><svg><use href=\"#icon-xmark-large\" /></svg></span>\n        </a>\n    {{/if}}\n</h2>\n"
}