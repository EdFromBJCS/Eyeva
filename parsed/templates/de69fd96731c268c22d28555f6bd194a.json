{
  "components/common/header": "<a href=\"#main-content\" class=\"skip-to-main-link\">{{lang 'header.skip_to_main'}}</a>\n{{!--\n<!--\n    Top Banner Carousel Instruction:\n    --------------------------------\n    Option 1:\n        Use HTML widget with content below:\n        ```html\n        <div data-banner-carousel>\n            <div>Banner 1 content</div>\n            <div>Banner 2 content</div>\n            <div>Banner 3 content</div>\n        </div>\n        ```\n\n    Option 2:\n        Create multiple Marketing Banners with location `top`: Admin Panel > Marketing > Banners\n-->\n--}}\n{{{region name=\"header_top--global\"}}}\n{{{region name=\"header_top\"}}}\n{{#if banners.top}}\n<div class=\"banners banners--top\" data-banner-location=\"top\">\n    <div data-banner-carousel>\n        {{#each banners.top_metadata}}\n        <div class=\"banner\" data-event-type=\"promotion\" data-entity-id=\"{{this.id}}\" data-name=\"{{this.banner-name}}\" data-position=\"{{this.location}}\" data-banner-id=\"{{this.banner-name}}\">\n            <div data-event-type=\"promotion-click\">\n                {{{this.content}}}\n            </div>\n        </div>\n        {{/each}}\n    </div>\n</div>\n{{/if}}\n\n<header class=\"header _{{theme_settings.logo-position}}\" data-sticky-header>\n    {{#if theme_settings.logo-position '===' 'center'}}\n        <div class=\"container\">\n            <div class=\"header-left\" data-nav-user>\n                {{> components/eyeva/header/menu-toggle}}\n                {{> components/eyeva/header/navuser-account}}\n                {{> components/eyeva/header/navuser-currency}}\n            </div>\n            {{> components/common/header/logo}}\n            <div class=\"header-right\" data-nav-user>\n                {{> components/eyeva/header/navuser-main}}\n            </div>\n        </div>\n        <div class=\"navPages-container\">\n            {{> components/eyeva/header/navigation type=theme_settings.navigation_design}}\n        </div>\n    {{else}}\n        <div class=\"container\">\n            <div class=\"header-left\">\n                {{> components/eyeva/header/menu-toggle}}\n                {{> components/common/header/logo}}\n            </div>\n            {{> components/eyeva/header/navigation type=theme_settings.navigation_design}}\n            <div class=\"header-right\" data-nav-user>\n                {{> components/eyeva/header/navuser-currency}}\n                {{> components/eyeva/header/navuser-account}}\n                {{> components/eyeva/header/navuser-main}}\n            </div>\n        </div>\n    {{/if}}\n</header>\n\n\n<div class=\"eyeva__mobileCategoryNav\">\n    {{#if theme_settings.show_nav_mobile}}\n        {{#if categories.length '>' 1}}\n            <div class=\"container\">\n                <ul class=\"eyeva__mobileCategoryNav-list\">\n                    {{#each categories}}\n                        <li class=\"eyeva__mobileCategoryNav-item\">\n                            <a href=\"{{url}}\" class=\"eyeva__mobileCategoryNav-link {{#if is_active}} _active{{/if}}\">{{name}}</a>\n                        </li>\n                    {{/each}}\n                </ul>\n            </div>\n        {{/if}}\n    {{/if}}\n    {{{region name=\"header_bottom_mobile--global\"}}}\n</div>\n\n{{{region name=\"header_bottom--global\"}}}\n{{{region name=\"header_bottom\"}}}\n",
  "components/eyeva/header/navuser-account": "{{#if customer}}\n    <button class=\"navUser-action _hasLabel\" type=\"button\"\n        data-collapsible=\"navUser-account\"\n        aria-controls=\"navUser-account\"\n        aria-expanded=\"false\"\n        data-menu-gap-cover\n        aria-label=\"{{lang 'common.account'}}\"\n    >\n        <i class=\"icon\">\n            <svg class=\"force-hide-mobile-tablet\"><use href=\"#icon-circle-user\"></use></svg>\n            <svg class=\"_open force-hide-desktop\"><use href=\"#icon-circle-user\"></use></svg>\n            <svg class=\"_close force-hide-desktop\"><use href=\"#icon-xmark-large\"></use></svg>\n        </i>\n        <span class=\"navUser-label\">{{lang 'common.account'}}</span>\n    </button>\n    <div class=\"navUser-subMenu\" id=\"navUser-account\" aria-hidden=\"true\" data-menu-dropdown {{#if theme_settings.logo-position '==' 'center'}}data-ignore-header-position{{/if}}>\n        <ul class=\"navUser-childList\">\n            {{#if customer.store_credit.value '>' 0}}\n                <li class=\"navUser-childList-item\">\n                    <a class=\"navUser-childList-action\">\n                        <span class=\"navUser-childList-label\">{{lang 'common.store_credit_overview' credit=customer.store_credit.formatted}}</span>\n                    </a>\n                </li>\n            {{/if}}\n            <li class=\"navUser-childList-item\">\n                <a class=\"navUser-childList-action\" href=\"{{urls.account.orders.all}}\">\n                    <span class=\"navUser-childList-label\">{{lang 'account.nav.orders'}}</span>\n                </a>\n            </li>\n            {{#if settings.returns_enabled}}\n                <li class=\"navUser-childList-item\">\n                    <a class=\"navUser-childList-action\" href=\"{{urls.account.returns}}\">\n                        <span class=\"navUser-childList-label\">{{lang 'account.nav.returns'}}</span>\n                    </a>\n                </li>\n            {{/if}}\n            <li class=\"navUser-childList-item\">\n                <a class=\"navUser-childList-action\" href=\"{{urls.account.inbox}}\">\n                    <span class=\"navUser-childList-label\">{{lang 'account.mobile_nav.messages'}}</span>\n                </a>\n            </li>\n            <li class=\"navUser-childList-item\">\n                <a class=\"navUser-childList-action\" href=\"{{urls.account.addresses}}\">\n                    <span class=\"navUser-childList-label\">{{lang 'account.nav.addresses'}}</span>\n                </a>\n            </li>\n            {{#if settings.show_payment_methods}}\n                <li class=\"navUser-childList-item\">\n                    <a class=\"navUser-childList-action\" href=\"{{urls.account.payment_methods.all}}\">\n                        <span class=\"navUser-childList-label\">{{lang 'account.nav.payment_methods'}}</span>\n                    </a>\n                </li>\n            {{/if}}\n            <li class=\"navUser-childList-item\">\n                <a class=\"navUser-childList-action\" href=\"{{urls.account.wishlists.all}}\">\n                    <span class=\"navUser-childList-label\">{{lang 'account.mobile_nav.wishlists'}}</span>\n                </a>\n            </li>\n            <li class=\"navUser-childList-item\">\n                <a class=\"navUser-childList-action\" href=\"{{urls.account.recent_items}}\">\n                    <span class=\"navUser-childList-label\">{{lang 'account.nav.recently_viewed'}}</span>\n                </a>\n            </li>\n            <li class=\"navUser-childList-item\">\n                <a class=\"navUser-childList-action\" href=\"{{urls.account.details}}\">\n                    <span class=\"navUser-childList-label\">{{lang 'account.nav.settings'}}</span>\n                </a>\n            </li>\n            <li class=\"navUser-childList-item\">\n                <a class=\"navUser-childList-action\" href=\"{{urls.auth.logout}}\">\n                    <span class=\"navUser-childList-label\">{{lang 'common.logout'}}</span>\n                </a>\n            </li>\n        </ul>\n    </div>\n{{else}}\n    <a class=\"navUser-action _hasLabel\" href=\"{{urls.auth.login}}\" aria-label=\"{{lang 'common.login'}}\">\n        <i class=\"icon\"><svg><use href=\"#icon-circle-user\"></use></svg></i>\n        <span class=\"navUser-label\">{{lang 'common.login'}}</span>\n    </a>\n{{/if}}\n",
  "components/eyeva/header/menu-toggle": "<button class=\"navUser-action _menu\" type=\"button\" data-collapsible=\"navPages\"\n    data-collapsible-disabled-breakpoint=\"medium\"\n    data-collapsible-disabled-state=\"open\"\n    data-collapsible-enabled-state=\"closed\"\n    aria-expanded=\"false\"\n    data-menu-toggle\n>\n    <i class=\"icon\">\n        <svg class=\"_open\"><use href=\"#icon-bars\"></use></svg>\n        <svg class=\"_close\"><use href=\"#icon-xmark-large\"></use></svg>\n    </i>\n    <span class=\"is-srOnly\">Toggle menu</span>\n</button>",
  "components/common/header/logo": "{{#if page_type '==' 'default'}}\n    <h1 class=\"header-logo\">\n        {{> components/common/store-logo}}\n    </h1>\n{{else}}\n    <div class=\"header-logo\">\n        {{> components/common/store-logo}}\n    </div>\n{{/if}}\n",
  "components/eyeva/header/navuser-currency": "{{#or customer (unless settings.hide_price_from_guests)}}\n    {{#if currency_selector.currencies.length '>' 1}}\n        <button class=\"navUser-action _currency\" type=\"button\"\n            data-collapsible=\"navUser-currency\"\n            aria-controls=\"navUser-currency\"\n            aria-expanded=\"false\"\n            aria-label=\"{{currency_selector.active_currency_code}}\"\n            data-menu-gap-cover\n        >\n            <span class=\"navUser-label-alt\">{{currency_selector.active_currency_code}}</span>\n            <i class=\"icon\" aria-hidden=\"true\"><svg><use href=\"#icon-chevron-down\" /></svg></i>\n        </button>\n        <div class=\"navUser-subMenu\" id=\"navUser-currency\" aria-hidden=\"true\" data-menu-dropdown {{#if theme_settings.logo-position '==' 'center'}}data-ignore-header-position{{/if}}>\n            <ul class=\"navUser-childList\">\n                {{#each currency_selector.currencies}}\n                    <li class=\"navUser-childList-item\">\n                        <a class=\"navUser-childList-action\" href=\"{{{switch_url}}}\"\n                            data-currency-code=\"{{{code}}}\"\n                            {{#if cart_currency_switch_url.length '>' 0 }}\n                                data-cart-currency-switch-url=\"{{{cart_currency_switch_url}}}\"\n                            {{/if}}\n                            data-warning=\"{{lang 'common.currency_switch_promotion'}}\"\n                        >\n                            {{#if is_active}}\n                                <strong>{{code}} - {{name}}</strong>\n                            {{else}}\n                                {{code}} - {{name}}\n                            {{/if}}\n                        </a>\n                    </li>\n                {{/each}}\n            </ul>\n        </div>\n    {{/if}}\n{{/or}}\n",
  "components/eyeva/header/navigation": "<div class=\"navPages\" id=\"navPages\">\n    {{#if theme_settings.menu_editing}}\n        {{> components/common/alert/alert-error \"Editing menu widgets. Remember to close this when finished from <b>Theme Styles</b> &gt; <b>Header and footer</b> &gt; <b>TURN ON EDITING MENU WIDGETS</b>\"}}\n    {{/if}}\n    {{#if customer}}\n        <div class=\"navPages-list _customer\">\n            <li class=\"navPages-item\">\n                {{> components/eyeva/header/navigation-account depth=1}}\n            </li>\n        </div>\n    {{/if}}\n\n    <ul class=\"navPages-list\">\n        {{#each categories}}\n            <li class=\"navPages-item\" {{#if children}}data-menu-gap-cover{{/if}}>\n                {{#if ../theme_settings.navigation_design '==' 'simple'}}\n                    {{> components/eyeva/header/navigation-mega depth=1}}\n                {{else}}\n                    {{> components/eyeva/header/navigation-list depth=1}}\n                {{/if}}\n            </li>\n        {{/each}}\n    </ul>\n\n    <ul class=\"navPages-list _webpages {{#if theme_settings.hide_content_navigation}}force-hide-desktop{{/if}}\">\n        {{#each pages}}\n            <li class=\"navPages-item\n                {{#unless ../theme_settings.hide_content_navigation}}\n                    {{#if (add @index 1) '<' (toInt ../theme_settings.webpage_start)}}\n                        force-hide-desktop\n                    {{else if (toInt ../theme_settings.webpage_limit)}}\n                        {{#if (add @index 2) '>' (add (toInt ../theme_settings.webpage_start) (toInt ../theme_settings.webpage_limit))}}\n                            force-hide-desktop\n                        {{/if}}\n                    {{/if}}\n                {{/unless}}\n                \" {{#if children}}data-menu-gap-cover{{/if}}>\n                {{#if ../theme_settings.navigation_design '==' 'simple'}}\n                    {{> components/eyeva/header/navigation-mega depth=1 is_page=true}}\n                {{else}}\n                    {{> components/eyeva/header/navigation-list  depth=1 is_page=true}}\n                {{/if}}\n            </li>\n        {{/each}}\n        {{#if settings.gift_certificates_enabled}}\n            <li class=\"navPages-item _gift {{#any theme_settings.hide_content_navigation theme_settings.hide_gift_cert}}force-hide-desktop{{/any}}\">\n                <a class=\"navPages-action _webpage\" href=\"{{urls.gift_certificate.purchase}}\" aria-label=\"{{lang 'common.gift_cert'}}\">\n                    <span class=\"navPages-label\">{{lang 'common.gift_cert'}}</span>\n                </a>\n            </li>\n        {{/if}}\n        {{#if currency_selector.currencies.length '>' 1}}\n            <li class=\"navPages-item _currency\">\n                <a class=\"navPages-action _webpage\" href=\"#\"\n                    data-collapsible=\"navPages-currency\"\n                    aria-controls=\"navPages-currency\"\n                    aria-expanded=\"false\"\n                    aria-label=\"{{lang 'common.currency' code=currency_selector.active_currency_code}}\"\n                >\n                    <span class=\"navPages-label\">{{lang 'common.currency' code=currency_selector.active_currency_code}}</span>\n                    <i class=\"icon\" aria-hidden=\"true\"><svg><use href=\"#icon-arrow-right-long\"></use></svg></i>\n                </a>\n                <div class=\"navPages-subMenu\" id=\"navPages-currency\" aria-hidden=\"true\" data-menu-dropdown>\n                    <ul class=\"navPages-childList\">\n                        <li class=\"navPages-childList-item _parent _depth-1\">\n                            <a class=\"navPages-childList-action  _parent _depth-1 _webpage\" href=\"#\"\n                                data-collapsible=\"navPages-currency\"\n                                aria-controls=\"navPages-currency\"\n                                aria-expanded=\"false\"\n                            >\n                                <i class=\"icon\" aria-hidden=\"true\"><svg><use href=\"#icon-arrow-left-long\"></use></svg></i>\n                                <span class=\"navPages-childList-label\">{{lang 'common.currency' code=currency_selector.active_currency_code}}</span>\n                            </a>\n                        </li>\n                        {{#each currency_selector.currencies}}\n                            <li class=\"navPages-childList-item\">\n                                <a class=\"navPages-childList-action {{#if is_active}} activePage{{/if}}\" href=\"{{switch_url}}\"\n                                    data-currency-code=\"{{{code}}}\"\n                                    {{#if cart_currency_switch_url.length '>' 0 }}\n                                        data-cart-currency-switch-url=\"{{{cart_currency_switch_url}}}\"\n                                    {{/if}}\n                                    data-warning=\"{{lang 'common.currency_switch_promotion'}}\"\n                                >\n                                    <span class=\"navPages-label\">{{name}}</span>\n                                </a>\n                            </li>\n                        {{/each}}\n                    </ul>\n                </div>\n            </li>\n        {{/if}}\n    </ul>\n    {{#unless customer}}\n        <div class=\"navPages-list _account\">\n            <p><span class=\"navPages-list-heading\">{{lang 'login.heading'}}</span></p>\n            <p>\n                {{lang 'login.new_customer.intro'}}\n                {{lang 'login.new_customer.fact1'}},\n                {{lang 'login.new_customer.fact2'}},\n                {{lang 'login.new_customer.fact3'}},\n                {{lang 'login.new_customer.fact4'}},\n                {{lang 'login.new_customer.fact5'}}\n            </p>\n            <p><a class=\"button button--primary\" href=\"{{urls.auth.login}}\">{{lang 'login.submit_value'}}</a></p>\n            {{#if settings.account_creation_enabled}}\n                <p>{{lang 'login.no_account'}} <a href=\"{{urls.auth.create_account}}\">{{lang 'login.sign_up'}}</a></p>\n            {{/if}}\n        </div>\n    {{/unless}}\n</div>",
  "components/eyeva/header/navuser-main": "<div class=\"navUser-list\">\n    <button class=\"navUser-action\" type=\"button\" data-papathemes-quick-search-toggle>\n        <i class=\"icon\"><svg><use href=\"#icon-magnifying-glass\"></use></svg></i>\n        <span class=\"is-srOnly\">{{lang 'common.search'}}</span>\n    </button>\n    {{#if customer}}\n        <a class=\"navUser-action\" href=\"{{urls.account.wishlists.all}}\">\n            <i class=\"icon\"><svg><use href=\"#icon-heart\"></use></svg></i>\n            <span class=\"is-srOnly\">{{lang 'common.wishlist'}}</span>\n        </a>\n    {{else}}\n        <button class=\"navUser-action\" type=\"button\" {{#unless customer}}data-wishlist-open{{/unless}}>\n            <i class=\"icon\"><svg><use href=\"#icon-heart\"></use></svg></i>\n            <span class=\"is-srOnly\">{{lang 'common.wishlist'}}</span>\n        </button>\n    {{/if}}\n    <a class=\"navUser-action\" type=\"button\"\n        {{#if page_type '!==' 'cart'}}\n            data-cart-drawer-toggle\n        {{/if}}\n        href=\"{{urls.cart}}\"\n        aria-label=\"{{lang 'cart.nav_aria_label'}}\"\n    >\n        <i class=\"icon\"><svg><use href=\"#icon-cart-shopping\"></use></svg></i>\n        <span class=\"countPill cart-quantity\"></span>\n    </a>\n</div>",
  "components/common/store-logo": "<a href=\"{{urls.home}}\" class=\"header-logo-link\" data-header-logo-link>\n    {{#if settings.store_logo.image}}\n        {{#if theme_settings.logo_size '===' 'original'}}\n            <img class=\"header-logo-image-unknown-size\"\n                    src=\"{{getImage settings.store_logo.image 'logo_size'}}\"\n                    alt=\"{{settings.store_logo.title}}\"\n                    title=\"{{settings.store_logo.title}}\">\n        {{else}}\n        <div class=\"header-logo-image-container\">\n            <img class=\"header-logo-image\"\n                    src=\"{{getImage settings.store_logo.image 'logo_size'}}\"\n                    srcset=\"{{getImageSrcset1x2x settings.store_logo.image theme_settings.logo_size}}\"\n                    alt=\"{{settings.store_logo.title}}\"\n                    title=\"{{settings.store_logo.title}}\">\n        </div>\n        {{/if}}\n    {{else}}\n        <span class=\"header-logo-text\">{{settings.store_logo.title}}</span>\n    {{/if}}\n</a>",
  "components/common/alert/alert-error": "<div class=\"alertBox alertBox--error\">\n    <div class=\"alertBox-column alertBox-icon\">\n        <icon glyph=\"ic-error\" class=\"icon\" aria-hidden=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z\"></path></svg></icon>\n    </div>\n    <p class=\"alertBox-column alertBox-message\">\n        <span id=\"alertBox-message-text\">{{{this}}}</span>\n    </p>\n</div>\n",
  "components/eyeva/header/navigation-mega": "{{#if children}}\n    {{#unless id}}\n        {{#if (merge this id=(concat 'page-' (incrementVar 'incrementId')))}}{{/if}}\n    {{/unless}}\n    <a class=\"navPages-action {{#if is_active}} activePage{{/if}} {{#if is_page}}_webpage{{/if}}\" href=\"{{url}}\"\n        data-collapsible=\"navPages-subMenu-{{id}}\"\n        data-collapsible-disabled-breakpoint=\"medium\"\n        data-collapsible-disabled-state=\"close\"\n        data-collapsible-enabled-state=\"close\"\n        aria-controls=\"navPages-subMenu-{{id}}\"\n        aria-expanded=\"false\"\n    >\n        <span class=\"navPages-label\">{{name}}</span>\n    </a>\n    <button class=\"navPages-subMenu-toggle _depth-{{depth}}\" type=\"button\"\n        data-collapsible=\"navPages-subMenu-{{id}}\"\n        aria-controls=\"navPages-subMenu-{{id}}\"\n        aria-expanded=\"false\"\n        aria-label=\"Toggle sub-menu\"\n    >\n        <span class=\"is-srOnly\">Toggle sub-menu</span>\n        <i class=\"icon hide-desktop\" aria-hidden=\"true\"><svg><use href=\"#icon-arrow-right-long\"></use></svg></i>\n        <i class=\"icon hide-mobile-tablet\" aria-hidden=\"true\"><svg><use href=\"#icon-chevron-down\"></use></svg></i>\n    </button>\n    <div class=\"navPages-megaMenu\" id=\"navPages-subMenu-{{id}}\" aria-hidden=\"true\" data-menu-dropdown>\n        <ul class=\"navPages-megaMenu-childList\">\n            <li class=\"navPages-childList-item _parent _mega _depth-{{depth}}\">\n                <a class=\"navPages-childList-action  _parent _depth-{{depth}} {{#if is_page}}_webpage{{/if}}\" href=\"{{url}}\"\n                    data-collapsible=\"navPages-subMenu-{{id}}\"\n                    aria-controls=\"navPages-subMenu-{{id}}\"\n                    aria-expanded=\"false\"\n                >\n                    <i class=\"icon\" aria-hidden=\"true\"><svg><use href=\"#icon-arrow-left-long\"></use></svg></i>\n                    <span class=\"navPages-childList-label\">{{name}}</span>\n                </a>\n            </li>\n            <li class=\"navPages-widgetRegion\">\n                {{{region name=(multiConcat \"menu_left_\" id \"--global\")}}}\n            </li>\n            {{#each children}}\n                <li class=\"navPages-megaMenu-column _left\">\n                    {{> components/eyeva/header/navigation-child-mega depth=(add ../depth 1)}}\n                </li>\n            {{/each}}\n            <li class=\"navPages-widgetRegion _right\">\n                {{{region name=(multiConcat \"menu_right_\" id \"--global\")}}}\n            </li>\n            <li class=\"navPages-widgetRegion _top\">\n                {{{region name=(multiConcat \"menu_top_\" id \"--global\")}}}\n            </li>\n        </ul>\n    </div>\n{{else}}\n    <a class=\"navPages-action {{#if is_active}} activePage{{/if}} {{#if is_page}}_webpage{{/if}}\" href=\"{{url}}\">\n        <span class=\"navPages-label\">{{name}}</span>\n    </a>\n{{/if}}",
  "components/eyeva/header/navigation-account": "<a class=\"navPages-action _webpage\" href=\"{{urls.account.index}}\"\n    data-collapsible=\"navPages-account\"\n    aria-controls=\"navPages-account\"\n    aria-expanded=\"false\"\n>\n    <span class=\"navPages-label\">{{lang 'common.account'}}</span>\n    <i class=\"icon\" aria-hidden=\"true\"><svg><use href=\"#icon-arrow-right-long\"></use></svg></i>\n</a>\n<div class=\"navPages-subMenu\" id=\"navPages-account\" aria-hidden=\"true\" data-menu-dropdown>\n    <ul class=\"navPages-childList\">\n        <li class=\"navPages-childList-item _parent _depth-{{depth}}\">\n            <a class=\"navPages-childList-action  _parent _depth-{{depth}} _webpage\" href=\"{{urls.account.index}}\"\n                data-collapsible=\"navPages-account\"\n                aria-controls=\"navPages-account\"\n                aria-expanded=\"false\"\n            >\n                <i class=\"icon\" aria-hidden=\"true\"><svg><use href=\"#icon-arrow-left-long\"></use></svg></i>\n                <span class=\"navPages-childList-label\">{{lang 'common.account'}}</span>\n            </a>\n        </li>\n        {{#if customer.store_credit.value '>' 0}}\n            <li class=\"navPages-childList-item\">\n                <a class=\"navPages-childList-action\">\n                    <span class=\"navPages-label\">{{lang 'common.store_credit_overview' credit=customer.store_credit.formatted}}</span>\n                </a>\n            </li>\n        {{/if}}\n        <li class=\"navPages-childList-item\">\n            <a class=\"navPages-childList-action\" href=\"{{urls.account.orders.all}}\">\n                <span class=\"navPages-label\">{{lang 'account.nav.orders'}}</span>\n            </a>\n        </li>\n        {{#if settings.returns_enabled}}\n            <li class=\"navPages-childList-item\">\n                <a class=\"navPages-childList-action\" href=\"{{urls.account.returns}}\">\n                    <span class=\"navPages-label\">{{lang 'account.nav.returns'}}</span>\n                </a>\n            </li>\n        {{/if}}\n        <li class=\"navPages-childList-item\">\n            <a class=\"navPages-childList-action\" href=\"{{urls.account.inbox}}\">\n                <span class=\"navPages-label\">{{lang 'account.mobile_nav.messages'}}</span>\n            </a>\n        </li>\n        <li class=\"navPages-childList-item\">\n            <a class=\"navPages-childList-action\" href=\"{{urls.account.addresses}}\">\n                <span class=\"navPages-label\">{{lang 'account.nav.addresses'}}</span>\n            </a>\n        </li>\n        {{#if settings.show_payment_methods}}\n            <li class=\"navPages-childList-item\">\n                <a class=\"navPages-childList-action\" href=\"{{urls.account.payment_methods.all}}\">\n                    <span class=\"navPages-label\">{{lang 'account.nav.payment_methods'}}</span>\n                </a>\n            </li>\n        {{/if}}\n        <li class=\"navPages-childList-item\">\n            <a class=\"navPages-childList-action\" href=\"{{urls.account.wishlists.all}}\">\n                <span class=\"navPages-label\">{{lang 'account.mobile_nav.wishlists'}}</span>\n            </a>\n        </li>\n        <li class=\"navPages-childList-item\">\n            <a class=\"navPages-childList-action\" href=\"{{urls.account.recent_items}}\">\n                <span class=\"navPages-label\">{{lang 'account.nav.recently_viewed'}}</span>\n            </a>\n        </li>\n        <li class=\"navPages-childList-item\">\n            <a class=\"navPages-childList-action\" href=\"{{urls.account.details}}\">\n                <span class=\"navPages-label\">{{lang 'account.nav.settings'}}</span>\n            </a>\n        </li>\n        <li class=\"navPages-childList-item\">\n            <a class=\"navPages-childList-action\" href=\"{{urls.auth.logout}}\">\n                <span class=\"navPages-label\">{{lang 'common.logout'}}</span>\n            </a>\n        </li>\n    </ul>\n</div>",
