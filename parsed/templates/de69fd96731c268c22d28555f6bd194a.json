{
  "components/common/header": "<a href=\"#main-content\" class=\"skip-to-main-link\">{{lang 'header.skip_to_main'}}</a>\r\n{{!--\r\n<!--\r\n    Top Banner Carousel Instruction:\r\n    --------------------------------\r\n    Option 1:\r\n        Use HTML widget with content below:\r\n        ```html\r\n        <div data-banner-carousel>\r\n            <div>Banner 1 content</div>\r\n            <div>Banner 2 content</div>\r\n            <div>Banner 3 content</div>\r\n        </div>\r\n        ```\r\n\r\n    Option 2:\r\n        Create multiple Marketing Banners with location `top`: Admin Panel > Marketing > Banners\r\n-->\r\n--}}\r\n{{{region name=\"header_top--global\"}}}\r\n{{{region name=\"header_top\"}}}\r\n{{#if banners.top}}\r\n<div class=\"banners banners--top\" data-banner-location=\"top\">\r\n    <div data-banner-carousel>\r\n        {{#each banners.top_metadata}}\r\n        <div class=\"banner\" data-event-type=\"promotion\" data-entity-id=\"{{this.id}}\" data-name=\"{{this.banner-name}}\" data-position=\"{{this.location}}\" data-banner-id=\"{{this.banner-name}}\">\r\n            <div data-event-type=\"promotion-click\">\r\n                {{{this.content}}}\r\n            </div>\r\n        </div>\r\n        {{/each}}\r\n    </div>\r\n</div>\r\n{{/if}}\r\n\r\n<header class=\"header _{{theme_settings.logo-position}}\" data-sticky-header>\r\n    {{#if theme_settings.logo-position '===' 'center'}}\r\n        <div class=\"container\">\r\n            <div class=\"header-left\" data-nav-user>\r\n                {{> components/eyeva/header/menu-toggle}}\r\n                {{> components/eyeva/header/navuser-account}}\r\n                {{> components/eyeva/header/navuser-currency}}\r\n            </div>\r\n            {{> components/common/header/logo}}\r\n            <div class=\"header-right\" data-nav-user>\r\n                {{> components/eyeva/header/navuser-main}}\r\n            </div>\r\n        </div>\r\n        <div class=\"navPages-container\">\r\n            {{> components/eyeva/header/navigation type=theme_settings.navigation_design}}\r\n        </div>\r\n    {{else}}\r\n        <div class=\"container\">\r\n            <div class=\"header-left\">\r\n                {{> components/eyeva/header/menu-toggle}}\r\n                {{> components/common/header/logo}}\r\n            </div>\r\n            {{> components/eyeva/header/navigation type=theme_settings.navigation_design}}\r\n            <div class=\"header-right\" data-nav-user>\r\n                {{> components/eyeva/header/navuser-currency}}\r\n                {{> components/eyeva/header/navuser-account}}\r\n                {{> components/eyeva/header/navuser-main}}\r\n            </div>\r\n        </div>\r\n    {{/if}}\r\n</header>\r\n\r\n\r\n<div class=\"eyeva__mobileCategoryNav\">\r\n    {{#if theme_settings.show_nav_mobile}}\r\n        {{#if categories.length '>' 1}}\r\n            <div class=\"container\">\r\n                <ul class=\"eyeva__mobileCategoryNav-list\">\r\n                    {{#each categories}}\r\n                        <li class=\"eyeva__mobileCategoryNav-item\">\r\n                            <a href=\"{{url}}\" class=\"eyeva__mobileCategoryNav-link {{#if is_active}} _active{{/if}}\">{{name}}</a>\r\n                        </li>\r\n                    {{/each}}\r\n                </ul>\r\n            </div>\r\n        {{/if}}\r\n    {{/if}}\r\n    {{{region name=\"header_bottom_mobile--global\"}}}\r\n</div>\r\n\r\n{{{region name=\"header_bottom--global\"}}}\r\n<li class=\"navPages-item info-panel\">\r\n    <div class=\"info-submenu\">\r\n        <ul class=\"info-links-list\">\r\n            {{#each pages}}\r\n            <li class=\"navPages-subMenu-item info-link-item\">\r\n                <a class=\"navPages-subMenu-action navPages-action\" href=\"{{url}}\">{{name}}</a>\r\n            </li>\r\n            {{/each}}\r\n        </ul>\r\n        <div class=\"map\"></div>\r\n        <ul class=\"navPages-subMenu-list navInfo\">\r\n            \r\n            <li class=\"navPages-subMenu-item storeInfo\">\r\n                <div class=\"deets\">\r\n                    <p><img src=\"{{cdn 'icons/phone.svg'}}\" alt=\"Phone Icon\" style=\"width: 20px; height: 20px; vertical-align: middle; margin-right: 0.25rem;\"><a href=\"tel:8772027788\">877-202-7788</a> or <a href=\"tel:3026592727\">302-659-2727</a></p>\r\n                    <p><img src=\"{{cdn 'icons/clock.svg'}}\" alt=\"Clock Icon\" style=\"width: 20px; height: 20px; vertical-align: middle; margin-right: 0.25rem;\"> 9am – 5pm Eastern, Monday – Friday</p>\r\n                    <p><img src=\"{{cdn 'icons/locationpin.svg'}}\" alt=\"Location Pin Icon\" style=\"width: 20px; height: 20px; vertical-align: middle; margin-right: 0.25rem;\"> 133 N Dupont Blvd Ste 103, Smyrna, DE 19977</p>\r\n                    <p><img src=\"{{cdn 'icons/taxes.svg'}}\" alt=\"Sales Tax\" style=\"width: 20px; height: 20px; vertical-align: middle; margin-right: 0.25rem;\"> Sale Tax Free Shopping!</p>\r\n                </div>\r\n            </li>\r\n            \r\n        </ul>\r\n    </div>\r\n</li>\r\n{{{region name=\"header_bottom\"}}}\r\n<script>\r\ndocument.addEventListener('DOMContentLoaded', function() {\r\n    const infoToggle = document.querySelector('.info-toggle');\r\n    const infoPanel = document.querySelector('.info-panel');\r\n    const headerEl = document.querySelector('header.header[data-sticky-header]') || document.querySelector('header.header');\r\n\r\n    if (!infoToggle || !infoPanel || !headerEl) return;\r\n\r\n    function positionInfoPanel() {\r\n        // Prefer the navPages container (if present and visible) so the panel sits under the full nav\r\n        let attachEl = headerEl;\r\n        const next = headerEl.nextElementSibling;\r\n        if (next && next.classList && next.classList.contains('navPages-container') && next.offsetHeight > 0) {\r\n            attachEl = next;\r\n        }\r\n\r\n        const rect = attachEl.getBoundingClientRect();\r\n        const topPx = Math.max(rect.bottom, 0);\r\n        infoPanel.style.position = 'fixed';\r\n        infoPanel.style.top = topPx + 'px';\r\n        infoPanel.style.left = '0px';\r\n        infoPanel.style.width = '100%';\r\n        infoPanel.style.zIndex = '9999';\r\n    }\r\n\r\n    // Compute initial position and keep it updated\r\n    positionInfoPanel();\r\n    window.addEventListener('resize', positionInfoPanel);\r\n    window.addEventListener('scroll', positionInfoPanel);\r\n\r\n    infoToggle.addEventListener('click', function(e) {\r\n        e.preventDefault();\r\n        e.stopPropagation();\r\n\r\n        const isOpen = infoPanel.classList.toggle('is-open');\r\n        infoToggle.classList.toggle('is-open', isOpen);\r\n        // ensure position after opening (content may change layout)\r\n        positionInfoPanel();\r\n    });\r\n\r\n    // Optional: click outside closes the panel\r\n    document.addEventListener('click', function(e) {\r\n        if (!infoPanel.contains(e.target) && !infoToggle.contains(e.target)) {\r\n            infoPanel.classList.remove('is-open');\r\n            infoToggle.classList.remove('is-open');\r\n        }\r\n    });\r\n\r\n    // Desktop: open panel on hover/focus for non-touch devices\r\n    const isTouch = ('ontouchstart' in window) || (navigator.maxTouchPoints && navigator.maxTouchPoints > 0);\r\n    if (!isTouch) {\r\n        let hoverTimeout = null;\r\n\r\n        function openPanel() {\r\n            if (!infoPanel.classList.contains('is-open')) {\r\n                infoPanel.classList.add('is-open');\r\n                infoToggle.classList.add('is-open');\r\n                positionInfoPanel();\r\n            }\r\n        }\r\n\r\n        function closePanel() {\r\n            infoPanel.classList.remove('is-open');\r\n            infoToggle.classList.remove('is-open');\r\n        }\r\n\r\n        infoToggle.addEventListener('mouseenter', function() {\r\n            clearTimeout(hoverTimeout);\r\n            openPanel();\r\n        });\r\n\r\n        infoToggle.addEventListener('mouseleave', function() {\r\n            hoverTimeout = setTimeout(closePanel, 250);\r\n        });\r\n\r\n        infoPanel.addEventListener('mouseenter', function() {\r\n            clearTimeout(hoverTimeout);\r\n        });\r\n\r\n        infoPanel.addEventListener('mouseleave', function() {\r\n            hoverTimeout = setTimeout(closePanel, 250);\r\n        });\r\n    }\r\n});\r\n</script>\r\n",
  "components/eyeva/header/menu-toggle": "<button class=\"navUser-action _menu\" type=\"button\" data-collapsible=\"navPages\"\n    data-collapsible-disabled-breakpoint=\"medium\"\n    data-collapsible-disabled-state=\"open\"\n    data-collapsible-enabled-state=\"closed\"\n    aria-expanded=\"false\"\n    data-menu-toggle\n>\n    <i class=\"icon\">\n        <svg class=\"_open\"><use href=\"#icon-bars\"></use></svg>\n        <svg class=\"_close\"><use href=\"#icon-xmark-large\"></use></svg>\n    </i>\n    <span class=\"is-srOnly\">Toggle menu</span>\n</button>\n",
  "components/eyeva/header/navuser-account": "{{#if customer}}\n    <button class=\"navUser-action _hasLabel\" type=\"button\"\n        data-collapsible=\"navUser-account\"\n        aria-controls=\"navUser-account\"\n        aria-expanded=\"false\"\n        data-menu-gap-cover\n        aria-label=\"{{lang 'common.account'}}\"\n    >\n        <i class=\"icon\">\n            <svg class=\"force-hide-mobile-tablet\"><use href=\"#icon-circle-user\"></use></svg>\n            <svg class=\"_open force-hide-desktop\"><use href=\"#icon-circle-user\"></use></svg>\n            <svg class=\"_close force-hide-desktop\"><use href=\"#icon-xmark-large\"></use></svg>\n        </i>\n        <span class=\"navUser-label\">{{lang 'common.account'}}</span>\n    </button>\n    <div class=\"navUser-subMenu\" id=\"navUser-account\" aria-hidden=\"true\" data-menu-dropdown {{#if theme_settings.logo-position '==' 'center'}}data-ignore-header-position{{/if}}>\n        <ul class=\"navUser-childList\">\n            {{#if customer.store_credit.value '>' 0}}\n                <li class=\"navUser-childList-item\">\n                    <a class=\"navUser-childList-action\">\n                        <span class=\"navUser-childList-label\">{{lang 'common.store_credit_overview' credit=customer.store_credit.formatted}}</span>\n                    </a>\n                </li>\n            {{/if}}\n            <li class=\"navUser-childList-item\">\n                <a class=\"navUser-childList-action\" href=\"{{urls.account.orders.all}}\">\n                    <span class=\"navUser-childList-label\">{{lang 'account.nav.orders'}}</span>\n                </a>\n            </li>\n            {{#if settings.returns_enabled}}\n                <li class=\"navUser-childList-item\">\n                    <a class=\"navUser-childList-action\" href=\"{{urls.account.returns}}\">\n                        <span class=\"navUser-childList-label\">{{lang 'account.nav.returns'}}</span>\n                    </a>\n                </li>\n            {{/if}}\n            <li class=\"navUser-childList-item\">\n                <a class=\"navUser-childList-action\" href=\"{{urls.account.inbox}}\">\n                    <span class=\"navUser-childList-label\">{{lang 'account.mobile_nav.messages'}}</span>\n                </a>\n            </li>\n            <li class=\"navUser-childList-item\">\n                <a class=\"navUser-childList-action\" href=\"{{urls.account.addresses}}\">\n                    <span class=\"navUser-childList-label\">{{lang 'account.nav.addresses'}}</span>\n                </a>\n            </li>\n            {{#if settings.show_payment_methods}}\n                <li class=\"navUser-childList-item\">\n                    <a class=\"navUser-childList-action\" href=\"{{urls.account.payment_methods.all}}\">\n                        <span class=\"navUser-childList-label\">{{lang 'account.nav.payment_methods'}}</span>\n                    </a>\n                </li>\n            {{/if}}\n            <li class=\"navUser-childList-item\">\n                <a class=\"navUser-childList-action\" href=\"{{urls.account.wishlists.all}}\">\n                    <span class=\"navUser-childList-label\">{{lang 'account.mobile_nav.wishlists'}}</span>\n                </a>\n            </li>\n            <li class=\"navUser-childList-item\">\n                <a class=\"navUser-childList-action\" href=\"{{urls.account.recent_items}}\">\n                    <span class=\"navUser-childList-label\">{{lang 'account.nav.recently_viewed'}}</span>\n                </a>\n            </li>\n            <li class=\"navUser-childList-item\">\n                <a class=\"navUser-childList-action\" href=\"{{urls.account.details}}\">\n                    <span class=\"navUser-childList-label\">{{lang 'account.nav.settings'}}</span>\n                </a>\n            </li>\n            <li class=\"navUser-childList-item\">\n                <a class=\"navUser-childList-action\" href=\"{{urls.auth.logout}}\">\n                    <span class=\"navUser-childList-label\">{{lang 'common.logout'}}</span>\n                </a>\n            </li>\n        </ul>\n    </div>\n{{else}}\n    <a class=\"navUser-action _hasLabel\" href=\"{{urls.auth.login}}\" aria-label=\"{{lang 'common.login'}}\">\n        <i class=\"icon\"><svg><use href=\"#icon-circle-user\"></use></svg></i>\n        <span class=\"navUser-label\">{{lang 'common.login'}}</span>\n    </a>\n{{/if}}\n",
  "components/eyeva/header/navigation": "<div class=\"navPages\" id=\"navPages\">\n    {{#if theme_settings.menu_editing}}\n        {{> components/common/alert/alert-error \"Editing menu widgets. Remember to close this when finished from <b>Theme Styles</b> &gt; <b>Header and footer</b> &gt; <b>TURN ON EDITING MENU WIDGETS</b>\"}}\n    {{/if}}\n    {{#if customer}}\n        <div class=\"navPages-list _customer\">\n            <li class=\"navPages-item\">\n                {{> components/eyeva/header/navigation-account depth=1}}\n            </li>\n        </div>\n    {{/if}}\n\n    <ul class=\"navPages-list\">\n        {{#each categories}}\n            <li class=\"navPages-item\" {{#if children}}data-menu-gap-cover{{/if}}>\n                {{#if ../theme_settings.navigation_design '==' 'simple'}}\n                    {{> components/eyeva/header/navigation-mega depth=1}}\n                {{else}}\n                    {{> components/eyeva/header/navigation-list depth=1}}\n                {{/if}}\n            </li>\n        {{/each}}\n<li class=\"navPages-item\">\n                <a class=\"navPages-action\" href=\"/repairs-service/?tab=0\">Repairs &amp; Service</a>\n            </li>\n<li class=\"navPages-item _info\">\n    <a href=\"#\" class=\"navPages-action info-toggle\">\n        Info\n        <i class=\"icon navPages-action-moreIcon\" aria-hidden=\"true\">\n            <svg><use href=\"#icon-chevron-down\"></use></svg>\n        </i>\n    </a>\n</li>\n    </ul>\n\n    <ul class=\"navPages-list _webpages {{#if theme_settings.hide_content_navigation}}force-hide-desktop{{/if}}\">\n        {{#each pages}}\n            <li class=\"navPages-item\n                {{#unless ../theme_settings.hide_content_navigation}}\n                    {{#if (add @index 1) '<' (toInt ../theme_settings.webpage_start)}}\n                        force-hide-desktop\n                    {{else if (toInt ../theme_settings.webpage_limit)}}\n                        {{#if (add @index 2) '>' (add (toInt ../theme_settings.webpage_start) (toInt ../theme_settings.webpage_limit))}}\n                            force-hide-desktop\n                        {{/if}}\n                    {{/if}}\n                {{/unless}}\n                \" {{#if children}}data-menu-gap-cover{{/if}}>\n                {{#if ../theme_settings.navigation_design '==' 'simple'}}\n                    {{> components/eyeva/header/navigation-mega depth=1 is_page=true}}\n                {{else}}\n                    {{> components/eyeva/header/navigation-list  depth=1 is_page=true}}\n                {{/if}}\n            </li>\n        {{/each}}\n        {{#if settings.gift_certificates_enabled}}\n            <li class=\"navPages-item _gift {{#any theme_settings.hide_content_navigation theme_settings.hide_gift_cert}}force-hide-desktop{{/any}}\">\n                <a class=\"navPages-action _webpage\" href=\"{{urls.gift_certificate.purchase}}\" aria-label=\"{{lang 'common.gift_cert'}}\">\n                    <span class=\"navPages-label\">{{lang 'common.gift_cert'}}</span>\n                </a>\n            </li>\n        {{/if}}\n        {{#if currency_selector.currencies.length '>' 1}}\n            <li class=\"navPages-item _currency\">\n                <a class=\"navPages-action _webpage\" href=\"#\"\n                    data-collapsible=\"navPages-currency\"\n                    aria-controls=\"navPages-currency\"\n                    aria-expanded=\"false\"\n                    aria-label=\"{{lang 'common.currency' code=currency_selector.active_currency_code}}\"\n                >\n                    <span class=\"navPages-label\">{{lang 'common.currency' code=currency_selector.active_currency_code}}</span>\n                    <i class=\"icon\" aria-hidden=\"true\"><svg><use href=\"#icon-arrow-right-long\"></use></svg></i>\n                </a>\n                <div class=\"navPages-subMenu\" id=\"navPages-currency\" aria-hidden=\"true\" data-menu-dropdown>\n                    <ul class=\"navPages-childList\">\n                        <li class=\"navPages-childList-item _parent _depth-1\">\n                            <a class=\"navPages-childList-action  _parent _depth-1 _webpage\" href=\"#\"\n                                data-collapsible=\"navPages-currency\"\n                                aria-controls=\"navPages-currency\"\n                                aria-expanded=\"false\"\n                            >\n                                <i class=\"icon\" aria-hidden=\"true\"><svg><use href=\"#icon-arrow-left-long\"></use></svg></i>\n                                <span class=\"navPages-childList-label\">{{lang 'common.currency' code=currency_selector.active_currency_code}}</span>\n                            </a>\n                        </li>\n                        {{#each currency_selector.currencies}}\n                            <li class=\"navPages-childList-item\">\n                                <a class=\"navPages-childList-action {{#if is_active}} activePage{{/if}}\" href=\"{{switch_url}}\"\n                                    data-currency-code=\"{{{code}}}\"\n                                    {{#if cart_currency_switch_url.length '>' 0 }}\n                                        data-cart-currency-switch-url=\"{{{cart_currency_switch_url}}}\"\n                                    {{/if}}\n                                    data-warning=\"{{lang 'common.currency_switch_promotion'}}\"\n                                >\n                                    <span class=\"navPages-label\">{{name}}</span>\n                                </a>\n                            </li>\n                        {{/each}}\n                    </ul>\n                </div>\n            </li>\n        {{/if}}\n    </ul>\n    {{#unless customer}}\n        <div class=\"navPages-list _account\">\n            <p><span class=\"navPages-list-heading\">{{lang 'login.heading'}}</span></p>\n            <p>\n                {{lang 'login.new_customer.intro'}}\n                {{lang 'login.new_customer.fact1'}},\n                {{lang 'login.new_customer.fact2'}},\n                {{lang 'login.new_customer.fact3'}},\n                {{lang 'login.new_customer.fact4'}},\n                {{lang 'login.new_customer.fact5'}}\n            </p>\n            <p><a class=\"button button--primary\" href=\"{{urls.auth.login}}\">{{lang 'login.submit_value'}}</a></p>\n            {{#if settings.account_creation_enabled}}\n                <p>{{lang 'login.no_account'}} <a href=\"{{urls.auth.create_account}}\">{{lang 'login.sign_up'}}</a></p>\n            {{/if}}\n        </div>\n    {{/unless}}\n</div>\n",
  "components/eyeva/header/navuser-currency": "{{#or customer (unless settings.hide_price_from_guests)}}\n    {{#if currency_selector.currencies.length '>' 1}}\n        <button class=\"navUser-action _currency\" type=\"button\"\n            data-collapsible=\"navUser-currency\"\n            aria-controls=\"navUser-currency\"\n            aria-expanded=\"false\"\n            aria-label=\"{{currency_selector.active_currency_code}}\"\n            data-menu-gap-cover\n        >\n            <span class=\"navUser-label-alt\">{{currency_selector.active_currency_code}}</span>\n            <i class=\"icon\" aria-hidden=\"true\"><svg><use href=\"#icon-chevron-down\" /></svg></i>\n        </button>\n        <div class=\"navUser-subMenu\" id=\"navUser-currency\" aria-hidden=\"true\" data-menu-dropdown {{#if theme_settings.logo-position '==' 'center'}}data-ignore-header-position{{/if}}>\n            <ul class=\"navUser-childList\">\n                {{#each currency_selector.currencies}}\n                    <li class=\"navUser-childList-item\">\n                        <a class=\"navUser-childList-action\" href=\"{{{switch_url}}}\"\n                            data-currency-code=\"{{{code}}}\"\n                            {{#if cart_currency_switch_url.length '>' 0 }}\n                                data-cart-currency-switch-url=\"{{{cart_currency_switch_url}}}\"\n                            {{/if}}\n                            data-warning=\"{{lang 'common.currency_switch_promotion'}}\"\n                        >\n                            {{#if is_active}}\n                                <strong>{{code}} - {{name}}</strong>\n                            {{else}}\n                                {{code}} - {{name}}\n                            {{/if}}\n                        </a>\n                    </li>\n                {{/each}}\n            </ul>\n        </div>\n    {{/if}}\n{{/or}}\n",
  "components/eyeva/header/navuser-main": "<div class=\"navUser-list\">\n    <button class=\"navUser-action\" type=\"button\" data-papathemes-quick-search-toggle>\n        <i class=\"icon\"><svg><use href=\"#icon-magnifying-glass\"></use></svg></i>\n        <span class=\"is-srOnly\">{{lang 'common.search'}}</span>\n    </button>\n    {{#if customer}}\n        <a class=\"navUser-action\" href=\"{{urls.account.wishlists.all}}\">\n            <i class=\"icon\"><svg><use href=\"#icon-heart\"></use></svg></i>\n            <span class=\"is-srOnly\">{{lang 'common.wishlist'}}</span>\n        </a>\n    {{else}}\n        <button class=\"navUser-action\" type=\"button\" {{#unless customer}}data-wishlist-open{{/unless}}>\n            <i class=\"icon\"><svg><use href=\"#icon-heart\"></use></svg></i>\n            <span class=\"is-srOnly\">{{lang 'common.wishlist'}}</span>\n        </button>\n    {{/if}}\n    <a class=\"navUser-action\" type=\"button\"\n        {{#if page_type '!==' 'cart'}}\n            data-cart-drawer-toggle\n        {{/if}}\n        href=\"{{urls.cart}}\"\n        aria-label=\"{{lang 'cart.nav_aria_label'}}\"\n    >\n        <i class=\"icon\"><svg><use href=\"#icon-cart-shopping\"></use></svg></i>\n        <span class=\"countPill cart-quantity\"></span>\n    </a>\n</div>\n",
  "components/common/header/logo": "{{#if page_type '==' 'default'}}\n    <h1 class=\"header-logo\">\n        {{> components/common/store-logo}}\n    </h1>\n{{else}}\n    <div class=\"header-logo\">\n        {{> components/common/store-logo}}\n    </div>\n{{/if}}\n",
  "components/common/alert/alert-error": "<!-- Double out of stock arlerts, removed the second one, this one\n<div class=\"alertBox alertBox--error\">\n    <div class=\"alertBox-column alertBox-icon\">\n        <icon glyph=\"ic-error\" class=\"icon\" aria-hidden=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z\"></path></svg></icon>\n    </div>\n    <p class=\"alertBox-column alertBox-message\">\n        <span id=\"alertBox-message-text\">{{{this}}}</span>\n    </p>\n</div>-->\n",
  "components/eyeva/header/navigation-account": "<a class=\"navPages-action _webpage\" href=\"{{urls.account.index}}\"\n    data-collapsible=\"navPages-account\"\n    aria-controls=\"navPages-account\"\n    aria-expanded=\"false\"\n>\n    <span class=\"navPages-label\">{{lang 'common.account'}}</span>\n    <i class=\"icon\" aria-hidden=\"true\"><svg><use href=\"#icon-arrow-right-long\"></use></svg></i>\n</a>\n<div class=\"navPages-subMenu\" id=\"navPages-account\" aria-hidden=\"true\" data-menu-dropdown>\n    <ul class=\"navPages-childList\">\n        <li class=\"navPages-childList-item _parent _depth-{{depth}}\">\n            <a class=\"navPages-childList-action  _parent _depth-{{depth}} _webpage\" href=\"{{urls.account.index}}\"\n                data-collapsible=\"navPages-account\"\n                aria-controls=\"navPages-account\"\n                aria-expanded=\"false\"\n            >\n                <i class=\"icon\" aria-hidden=\"true\"><svg><use href=\"#icon-arrow-left-long\"></use></svg></i>\n                <span class=\"navPages-childList-label\">{{lang 'common.account'}}</span>\n            </a>\n        </li>\n        {{#if customer.store_credit.value '>' 0}}\n            <li class=\"navPages-childList-item\">\n                <a class=\"navPages-childList-action\">\n                    <span class=\"navPages-label\">{{lang 'common.store_credit_overview' credit=customer.store_credit.formatted}}</span>\n                </a>\n            </li>\n        {{/if}}\n        <li class=\"navPages-childList-item\">\n            <a class=\"navPages-childList-action\" href=\"{{urls.account.orders.all}}\">\n                <span class=\"navPages-label\">{{lang 'account.nav.orders'}}</span>\n            </a>\n        </li>\n        {{#if settings.returns_enabled}}\n            <li class=\"navPages-childList-item\">\n                <a class=\"navPages-childList-action\" href=\"{{urls.account.returns}}\">\n                    <span class=\"navPages-label\">{{lang 'account.nav.returns'}}</span>\n                </a>\n            </li>\n        {{/if}}\n        <li class=\"navPages-childList-item\">\n            <a class=\"navPages-childList-action\" href=\"{{urls.account.inbox}}\">\n                <span class=\"navPages-label\">{{lang 'account.mobile_nav.messages'}}</span>\n            </a>\n        </li>\n        <li class=\"navPages-childList-item\">\n            <a class=\"navPages-childList-action\" href=\"{{urls.account.addresses}}\">\n                <span class=\"navPages-label\">{{lang 'account.nav.addresses'}}</span>\n            </a>\n        </li>\n        {{#if settings.show_payment_methods}}\n            <li class=\"navPages-childList-item\">\n                <a class=\"navPages-childList-action\" href=\"{{urls.account.payment_methods.all}}\">\n                    <span class=\"navPages-label\">{{lang 'account.nav.payment_methods'}}</span>\n                </a>\n            </li>\n        {{/if}}\n        <li class=\"navPages-childList-item\">\n            <a class=\"navPages-childList-action\" href=\"{{urls.account.wishlists.all}}\">\n                <span class=\"navPages-label\">{{lang 'account.mobile_nav.wishlists'}}</span>\n            </a>\n        </li>\n        <li class=\"navPages-childList-item\">\n            <a class=\"navPages-childList-action\" href=\"{{urls.account.recent_items}}\">\n                <span class=\"navPages-label\">{{lang 'account.nav.recently_viewed'}}</span>\n            </a>\n        </li>\n        <li class=\"navPages-childList-item\">\n            <a class=\"navPages-childList-action\" href=\"{{urls.account.details}}\">\n                <span class=\"navPages-label\">{{lang 'account.nav.settings'}}</span>\n            </a>\n        </li>\n        <li class=\"navPages-childList-item\">\n            <a class=\"navPages-childList-action\" href=\"{{urls.auth.logout}}\">\n                <span class=\"navPages-label\">{{lang 'common.logout'}}</span>\n            </a>\n        </li>\n    </ul>\n</div>\n",
  "components/eyeva/header/navigation-list": "{{#if children}}\n    {{#unless id}}\n        {{#if (merge this id=(concat 'page-' (incrementVar 'incrementId')))}}{{/if}}\n    {{/unless}}\n    <a class=\"navPages-action {{#if is_active}} activePage{{/if}} {{#if is_page}}_webpage{{/if}}\" href=\"{{url}}\"\n        data-collapsible=\"navPages-subMenu-{{id}}\"\n        data-collapsible-disabled-breakpoint=\"medium\"\n        data-collapsible-disabled-state=\"close\"\n        data-collapsible-enabled-state=\"close\"\n        aria-controls=\"navPages-subMenu-{{id}}\"\n        aria-expanded=\"false\"\n    >\n        <span class=\"navPages-label\">{{name}}</span>\n    </a>\n    <button class=\"navPages-subMenu-toggle _depth-{{depth}}\" type=\"button\"\n        data-collapsible=\"navPages-subMenu-{{id}}\"\n        aria-controls=\"navPages-subMenu-{{id}}\"\n        aria-expanded=\"false\"\n        aria-label=\"Toggle sub-menu\"\n    >\n        <span class=\"is-srOnly\">Toggle sub-menu</span>\n        <i class=\"icon hide-desktop\" aria-hidden=\"true\"><svg><use href=\"#icon-arrow-right-long\"></use></svg></i>\n        <i class=\"icon hide-mobile-tablet\" aria-hidden=\"true\"><svg><use href=\"#icon-chevron-down\"></use></svg></i>\n    </button>\n    <div class=\"navPages-subMenu\" id=\"navPages-subMenu-{{id}}\" aria-hidden=\"true\" data-menu-dropdown>\n        <ul class=\"navPages-childList\">\n            <li class=\"navPages-childList-item _parent _depth-{{depth}}\">\n                <a class=\"navPages-childList-action  _parent _depth-{{depth}} {{#if is_page}}_webpage{{/if}}\" href=\"{{url}}\"\n                    data-collapsible=\"navPages-subMenu-{{id}}\"\n                    aria-controls=\"navPages-subMenu-{{id}}\"\n                    aria-expanded=\"false\"\n                >\n                    <i class=\"icon\" aria-hidden=\"true\"><svg><use href=\"#icon-arrow-left-long\"></use></svg></i>\n                    <span class=\"navPages-childList-label\">{{name}}</span>\n                </a>\n            </li>\n            {{#each children}}\n                <li class=\"navPages-childList-item\">\n                    {{> components/eyeva/header/navigation-child-list depth=(add ../depth 1)}}\n                </li>\n            {{/each}}\n        </ul>\n    </div>\n{{else}}\n    <a class=\"navPages-action {{#if is_active}} activePage{{/if}} {{#if is_page}}_webpage{{/if}}\" href=\"{{url}}\">\n        <span class=\"navPages-label\">{{name}}</span>\n    </a>\n{{/if}}\n",
  "components/eyeva/header/navigation-mega": "{{#if children}}\r\n    {{#unless id}}\r\n        {{#if (merge this id=(concat 'page-' (incrementVar 'incrementId')))}}{{/if}}\r\n    {{/unless}}\r\n    <a class=\"navPages-action {{#if is_active}} activePage{{/if}} {{#if is_page}}_webpage{{/if}}\" href=\"{{url}}\"\r\n        data-collapsible=\"navPages-subMenu-{{id}}\"\r\n        data-collapsible-disabled-breakpoint=\"medium\"\r\n        data-collapsible-disabled-state=\"close\"\r\n        data-collapsible-enabled-state=\"close\"\r\n        aria-controls=\"navPages-subMenu-{{id}}\"\r\n        aria-expanded=\"false\"\r\n    >\r\n        <span class=\"navPages-label\">{{name}}</span>\r\n    </a>\r\n    <button class=\"navPages-subMenu-toggle _depth-{{depth}}\" type=\"button\"\r\n        data-collapsible=\"navPages-subMenu-{{id}}\"\r\n        aria-controls=\"navPages-subMenu-{{id}}\"\r\n        aria-expanded=\"false\"\r\n        aria-label=\"Toggle sub-menu\"\r\n    >\r\n        <span class=\"is-srOnly\">Toggle sub-menu</span>\r\n        <i class=\"icon hide-desktop\" aria-hidden=\"true\"><svg><use href=\"#icon-arrow-right-long\"></use></svg></i>\r\n        <i class=\"icon hide-mobile-tablet\" aria-hidden=\"true\"><svg><use href=\"#icon-chevron-down\"></use></svg></i>\r\n    </button>\r\n    <div class=\"navPages-megaMenu\" id=\"navPages-subMenu-{{id}}\" aria-hidden=\"true\" data-menu-dropdown>\r\n        <ul class=\"navPages-megaMenu-childList\">\r\n            <li class=\"navPages-childList-item _parent _mega _depth-{{depth}}\">\r\n                <a class=\"navPages-childList-action  _parent _depth-{{depth}} {{#if is_page}}_webpage{{/if}}\" href=\"{{url}}\"\r\n                    data-collapsible=\"navPages-subMenu-{{id}}\"\r\n                    aria-controls=\"navPages-subMenu-{{id}}\"\r\n                    aria-expanded=\"false\"\r\n                >\r\n                    <i class=\"icon\" aria-hidden=\"true\"><svg><use href=\"#icon-arrow-left-long\"></use></svg></i>\r\n                    <span class=\"navPages-childList-label\">{{name}}</span>\r\n                </a>\r\n            </li>\r\n            <li class=\"navPages-widgetRegion\">\r\n                {{{region name=(multiConcat \"menu_left_\" id \"--global\")}}}\r\n            </li>\r\n            {{#each children}}\r\n                <li class=\"navPages-megaMenu-column _left\">\r\n                    {{> components/eyeva/header/navigation-child-mega depth=(add ../depth 1)}}\r\n                </li>\r\n            {{/each}}\r\n            <li class=\"navPages-widgetRegion _right\">\r\n                {{{region name=(multiConcat \"menu_right_\" id \"--global\")}}}\r\n            </li>\r\n            <li class=\"navPages-widgetRegion _top\">\r\n                {{{region name=(multiConcat \"menu_top_\" id \"--global\")}}}\r\n            </li>\r\n        </ul>\r\n    </div>\r\n{{else}}\r\n    <a class=\"navPages-action {{#if is_active}} activePage{{/if}} {{#if is_page}}_webpage{{/if}}\" href=\"{{url}}\">\r\n        <span class=\"navPages-label\">{{name}}</span>\r\n    </a>\r\n{{/if}}\r\n",
  "components/common/store-logo": "<a href=\"{{urls.home}}\" class=\"header-logo-link\" data-header-logo-link>\n    {{#if settings.store_logo.image}}\n        {{#if theme_settings.logo_size '===' 'original'}}\n            <img class=\"header-logo-image-unknown-size\"\n                    src=\"{{getImage settings.store_logo.image 'logo_size'}}\"\n                    alt=\"{{settings.store_logo.title}}\"\n                    title=\"{{settings.store_logo.title}}\">\n        {{else}}\n        <div class=\"header-logo-image-container\">\n            <img class=\"header-logo-image\"\n                    src=\"{{getImage settings.store_logo.image 'logo_size'}}\"\n                    srcset=\"{{getImageSrcset1x2x settings.store_logo.image theme_settings.logo_size}}\"\n                    alt=\"{{settings.store_logo.title}}\"\n                    title=\"{{settings.store_logo.title}}\">\n        </div>\n        {{/if}}\n    {{else}}\n        <span class=\"header-logo-text\">{{settings.store_logo.title}}</span>\n    {{/if}}\n</a>\n",
