{
  "components/account/wishlist-list": "<div class=\"eyeva__wishlists-table\">\n    <div class=\"_header\">\n        <div class=\"_row\">\n            <div class=\"_col\">{{lang 'account.wishlists.name'}}</div class=\"_col\">\n            <div class=\"_col\">{{lang 'account.wishlists.num_items'}}</div class=\"_col\">\n            <div class=\"_col\">{{lang 'account.wishlists.shared'}}</div class=\"_col\">\n            <div class=\"_col\">{{lang 'account.wishlists.action'}}</div class=\"_col\">\n        </div>\n    </div>\n    <div class=\"_body\">\n    {{#each customer.wishlists}}\n        <div class=\"_row\">\n            <div class=\"_col\"><span class=\"_num\">{{num_items}}</span></div>\n            <div class=\"_col\">\n                {{#if is_public }}\n                    <a href=\"{{share_url}}\" class=\"_public\">\n                        <span class=\"is-srOnly\">{{lang 'common.yes'}}</span>\n                        <i class=\"icon\"><svg><use href=\"#icon-link-horizontal\"></use></svg></i>\n                    </a>\n                {{else}}\n                    <span class=\"_private\">\n                        <span class=\"is-srOnly\">{{lang 'common.no'}}</span>\n                        <i class=\"icon\"><svg><use href=\"#icon-link-horizontal-slash\"></use></svg></i>\n                    </span>\n                {{/if}}\n            </div>\n            <div class=\"_col\"><a href=\"{{view_url}}\" class=\"_name\">{{name}}</a></div>\n            <div class=\"_col\">\n                <form method=\"post\" action=\"{{delete_url}}\" class=\"form\">\n                    <fieldset class=\"form-fieldset\">\n                        <a href=\"{{edit_url}}\" class=\"button button--primary button--small button--icon\" data-wishlist>\n                            <span class=\"is-srOnly\">{{lang 'common.edit'}}</span>\n                            <i class=\"icon\"><svg class=\"icon\"><use href=\"#icon-pen\"></use></svg></i>\n                        </a>\n                        <button type=\"submit\" class=\"button button--outline button--small button--icon\" data-wishlist-delete>\n                            <span class=\"is-srOnly\">{{lang 'common.delete'}}</span>\n                            <i class=\"icon\"><svg class=\"icon\"><use href=\"#icon-trash\"></use></svg></i>\n                        </button>\n                    </fieldset>\n                </form>\n            </div>\n        </div>\n    {{/each}}\n    </div>\n</div>\n<form method=\"post\" action=\"{{this.urls.account.wishlists.delete}}\" class=\"form\">\n    {{#unless customer.wishlists}}\n        <p class=\"eyeva__wishlists-form-actions\">{{> components/common/alert/alert-info (lang 'account.wishlists.you_have_none')}}</p>\n\n    {{/unless}}\n    <div class=\"eyeva__wishlists-form-actions\">\n        <a href=\"{{this.urls.account.wishlists.add}}\" class=\"button button--primary\" role=\"button\" data-wishlist>\n            <i class=\"icon icon--left\"><svg><use href=\"#icon-plus\"></use></svg></i>\n            {{lang 'account.wishlists.new'}}\n        </a>\n        {{inject 'wishlistDelete' (lang 'account.wishlists.delete_alert')}}\n        {{#if customer.wishlists}}\n            {{#each customer.wishlists}}\n                <input type=\"hidden\" value=\"{{this.id}}\" name=\"deletewishlist[]\">\n            {{/each}}\n            <input type=\"submit\" value=\"{{lang 'account.wishlists.delete_all'}}\" class=\"button button--outline\" data-wishlist-delete>\n        {{/if}}\n    </div>\n</form>\n",
  "components/common/alert/alert-info": "<div class=\"alertBox alertBox--info\" data-promotion-banner>\n    <div class=\"alertBox-column alertBox-icon\">\n        <icon glyph=\"ic-success\" class=\"icon\" aria-hidden=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z\"></path></svg></icon>\n    </div>\n    <p class=\"alertBox-column alertBox-message\">\n        <span>{{{this}}}</span>\n    </p>\n</div>\n"
}
