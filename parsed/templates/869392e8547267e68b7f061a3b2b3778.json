{
  "components/faceted-search/header": "<div class=\"facetedSearch-selected\">\n    <button type=\"button\" class=\"plp-page-sidebar-toggle\"\n        data-collapsible=\"page-sidebar\"\n        data-collapsible-disabled-breakpoint=\"medium\"\n        data-collapsible-disabled-state=\"open\"\n        data-collapsible-enabled-state=\"closed\"\n        >\n        <span class=\"_indicator\">\n            <i class=\"icon\" aria-hidden=\"true\">\n                <svg><use href=\"#icon-sliders-up\"/></svg>\n            </i>\n        </span>\n\n        <span class=\"_text\">\n            {{lang 'search.faceted.filters'}}\n        </span>\n\n        {{#if selected.items.length}}\n            <span class=\"_count\">\n                {{selected.items.length}}\n            </span>\n        {{/if}}\n    </button>\n\n    {{#if faceted_search_enabled}}\n        {{> components/faceted-search/selected-facets selected}}\n    {{/if}}\n</div>\n",
  "components/faceted-search/selected-facets": "<div class=\"facetedSearch-refineFilters\" role=\"region\" aria-label=\"{{lang 'search.faceted.selected.facet-label'}}\">\n    <h2 class=\"is-srOnly\">\n        {{lang 'search.faceted.selected.title'}}\n    </h2>\n\n    {{#if items}}\n        <ul class=\"_list\">\n            {{#each items}}\n                <li class=\"_item\">\n                    <a href=\"{{url}}\"\n                       class=\"_link\"\n                       rel=\"nofollow\"\n                       data-faceted-search-facet\n                    >\n                        <svg class=\"icon\">\n                            <use href=\"#icon-xmark-large\" />\n                        </svg>\n\n                        {{#if facet '===' 'rating'}}\n                            {{lang 'search.faceted.selected.rating-label' rating=title}}\n                        {{else}}\n                            {{{sanitize title}}}\n                        {{/if}}\n                    </a>\n                </li>\n            {{/each}}\n            {{#if remove_all_url}}\n                <li class=\"_item\">\n                    <a href=\"{{remove_all_url}}\" class=\"_link-clearall\" data-faceted-search-facet>\n                        {{lang 'search.faceted.selected.clear-all'}}\n                    </a>\n                </li>\n            {{/if}}\n        </ul>\n    {{/if}}\n</div>\n"
}