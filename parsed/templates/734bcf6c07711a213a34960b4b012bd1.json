{
  "components/papathemes/create-wishlist-modal": "<div id=\"creatingWishlistModalContent\" style=\"display:none\">\n    <form action=\"{{urls.account.wishlists.add}}\" class=\"form\" method=\"post\">\n        <div class=\"form-field\">\n            <label class=\"form-label\" for=\"creatingWishlistModalContent_wishlistname\">\n                {{lang 'forms.wishlist.name'}}\n                <small>{{lang 'common.required' }}</small>\n            </label>\n            <input class=\"form-input\" name=\"wishlistname\" id=\"creatingWishlistModalContent_wishlistname\" value=\"\" required>\n        </div>\n        <div class=\"form-field\">\n            <input type=\"checkbox\" class=\"form-checkbox\" name=\"publicwishlist\" id=\"creatingWishlistModalContent_publicwishlist\">\n            <label class=\"form-label\" for=\"creatingWishlistModalContent_publicwishlist\">{{lang 'forms.wishlist.public'}}</label>\n\n        </div>\n        <div class=\"form-actions\">\n            <input type=\"submit\" class=\"button button--primary\" value=\"{{lang 'account.wishlists.create'}}\">\n        </div>\n    </form>\n</div>\n"
}