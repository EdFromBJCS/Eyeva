{
  "components/faceted-search/faceted-search-navigation": "<h2 class=\"accordion-heading accordion-nav-clear-holder\">\n        <button type=\"button\"\n            class=\"accordion-navigation {{#if selected}} is-open{{/if}}\"\n         data-collapsible=\"#facetedSearch-content--{{dashcase facet}}\"\n         aria-label=\"{{lang 'search.faceted.toggleSection' title=title}}\"\n    >\n        <span class=\"_title\">\n            {{title}}\n        </span>\n\n        {{#if selected}}\n            <span class=\"_count\">1</span>\n        {{/if}}\n\n        <span class=\"icon\"><svg><use href=\"#icon-chevron-down\" /></svg></span>\n    </button>\n    {{#if selected}}\n        <a href=\"{{remove_url}}\" class=\"facetedSearch-clearLink\" data-faceted-search-facet>\n            <span class=\"is-srOnly\">{{lang 'search.faceted.clear'}}</span>\n            <span class=\"icon\"><svg><use href=\"#icon-xmark-large\" /></svg></span>\n        </a>\n    {{/if}}\n</h2>\n"
}