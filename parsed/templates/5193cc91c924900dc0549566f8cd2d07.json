{
  "components/eyeva/header/navigation-mega": "{{#if children}}\n    {{#unless id}}\n        {{#if (merge this id=(concat 'page-' (incrementVar 'incrementId')))}}{{/if}}\n    {{/unless}}\n    <a class=\"navPages-action {{#if is_active}} activePage{{/if}} {{#if is_page}}_webpage{{/if}}\" href=\"{{url}}\"\n        data-collapsible=\"navPages-subMenu-{{id}}\"\n        data-collapsible-disabled-breakpoint=\"medium\"\n        data-collapsible-disabled-state=\"close\"\n        data-collapsible-enabled-state=\"close\"\n        aria-controls=\"navPages-subMenu-{{id}}\"\n        aria-expanded=\"false\"\n    >\n        <span class=\"navPages-label\">{{name}}</span>\n    </a>\n    <button class=\"navPages-subMenu-toggle _depth-{{depth}}\" type=\"button\"\n        data-collapsible=\"navPages-subMenu-{{id}}\"\n        aria-controls=\"navPages-subMenu-{{id}}\"\n        aria-expanded=\"false\"\n        aria-label=\"Toggle sub-menu\"\n    >\n        <span class=\"is-srOnly\">Toggle sub-menu</span>\n        <i class=\"icon hide-desktop\" aria-hidden=\"true\"><svg><use href=\"#icon-arrow-right-long\"></use></svg></i>\n        <i class=\"icon hide-mobile-tablet\" aria-hidden=\"true\"><svg><use href=\"#icon-chevron-down\"></use></svg></i>\n    </button>\n    <div class=\"navPages-megaMenu\" id=\"navPages-subMenu-{{id}}\" aria-hidden=\"true\" data-menu-dropdown>\n        <ul class=\"navPages-megaMenu-childList\">\n            <li class=\"navPages-childList-item _parent _mega _depth-{{depth}}\">\n                <a class=\"navPages-childList-action  _parent _depth-{{depth}} {{#if is_page}}_webpage{{/if}}\" href=\"{{url}}\"\n                    data-collapsible=\"navPages-subMenu-{{id}}\"\n                    aria-controls=\"navPages-subMenu-{{id}}\"\n                    aria-expanded=\"false\"\n                >\n                    <i class=\"icon\" aria-hidden=\"true\"><svg><use href=\"#icon-arrow-left-long\"></use></svg></i>\n                    <span class=\"navPages-childList-label\">{{name}}</span>\n                </a>\n            </li>\n            <li class=\"navPages-widgetRegion\">\n                {{{region name=(multiConcat \"menu_left_\" id \"--global\")}}}\n            </li>\n            {{#each children}}\n                <li class=\"navPages-megaMenu-column _left\">\n                    {{> components/eyeva/header/navigation-child-mega depth=(add ../depth 1)}}\n                </li>\n            {{/each}}\n            <li class=\"navPages-widgetRegion _right\">\n                {{{region name=(multiConcat \"menu_right_\" id \"--global\")}}}\n            </li>\n            <li class=\"navPages-widgetRegion _top\">\n                {{{region name=(multiConcat \"menu_top_\" id \"--global\")}}}\n            </li>\n        </ul>\n    </div>\n{{else}}\n    <a class=\"navPages-action {{#if is_active}} activePage{{/if}} {{#if is_page}}_webpage{{/if}}\" href=\"{{url}}\">\n        <span class=\"navPages-label\">{{name}}</span>\n    </a>\n{{/if}}",
  "components/eyeva/header/navigation-child-mega": "{{#if children}}\n    {{#unless id}}\n        {{#if (merge this id=(concat 'page-' (incrementVar 'incrementId')))}}{{/if}}\n    {{/unless}}\n    <a class=\"navPages-childList-action _mega {{#if is_active}} activePage{{/if}}\" href=\"{{url}}\">\n        <span class=\"navPages-label\">{{name}}</span>\n    </a>\n    <div class=\"navPages-megaMenu-subMenu\">\n        <ul class=\"navPages-megaMenu-childList\">\n            {{#each children}}\n                <li class=\"navPages-childList-item\">\n                    {{> components/eyeva/header/navigation-child-list depth=(add ../depth 1)}}\n                </li>\n            {{/each}}\n        </ul>\n    </div>\n{{else}}\n    <a class=\"navPages-childList-action _mega {{#if is_active}} activePage{{/if}}\" href=\"{{url}}\">\n        <span class=\"navPages-label\">{{name}}</span>\n    </a>\n{{/if}}",
  "components/eyeva/header/navigation-child-list": "{{#if children}}\n    {{#unless id}}\n        {{#if (merge this id=(concat 'page-' (incrementVar 'incrementId')))}}{{/if}}\n    {{/unless}}\n    <a class=\"navPages-childList-action {{#if is_active}} activePage{{/if}}\" href=\"{{url}}\"\n        data-collapsible=\"navPages-subMenu-{{id}}\"\n        data-collapsible-disabled-breakpoint=\"medium\"\n        data-collapsible-disabled-state=\"closed\"\n        data-collapsible-enabled-state=\"closed\"\n        aria-controls=\"navPages-subMenu-{{id}}\"\n        aria-expanded=\"false\"\n    >\n        <span class=\"navPages-label\">{{name}}</span>\n    </a>\n    <button class=\"navPages-subMenu-toggle _depth-{{depth}}\" type=\"button\"\n        data-collapsible=\"navPages-subMenu-{{id}}\"\n        aria-controls=\"navPages-subMenu-{{id}}\"\n        aria-expanded=\"false\"\n        aria-label=\"Toggle sub-menu\"\n    >\n        <span class=\"is-srOnly\">Toggle sub-menu</span>\n        <i class=\"icon\" aria-hidden=\"true\"><svg><use href=\"#icon-arrow-right-long\"></use></svg></i>\n    </button>\n    <div class=\"navPages-subMenu\" id=\"navPages-subMenu-{{id}}\" aria-hidden=\"true\">\n        <ul class=\"navPages-childList\">\n            <li class=\"navPages-childList-item _parent _depth-{{depth}}\">\n                <a class=\"navPages-childList-action _parent _depth-{{depth}}\" href=\"{{url}}\"\n                    data-collapsible=\"navPages-subMenu-{{id}}\"\n                    aria-controls=\"navPages-subMenu-{{id}}\"\n                    aria-expanded=\"false\"\n                >\n                    <i class=\"icon\" aria-hidden=\"true\"><svg><use href=\"#icon-arrow-left-long\"></use></svg></i>\n                    <span class=\"navPages-childList-label\">{{name}}</span>\n                </a>\n            </li>\n            {{#each children}}\n                <li class=\"navPages-childList-item\">\n                    {{> components/eyeva/header/navigation-child-list depth=(add ../depth 1)}}\n                </li>\n            {{/each}}\n        </ul>\n    </div>\n{{else}}\n    <a class=\"navPages-childList-action{{#if is_active}} activePage{{/if}}\" href=\"{{url}}\">\n        <span class=\"navPages-label\">{{name}}</span>\n    </a>\n{{/if}}"
}
