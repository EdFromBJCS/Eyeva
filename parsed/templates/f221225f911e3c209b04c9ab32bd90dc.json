{
  "components/faceted-search/facets/multi": "{{#if items}}\n<div class=\"accordion-block\">\n    {{> components/faceted-search/faceted-search-navigation}}\n\n    <div id=\"facetedSearch-content--{{dashcase facet}}\" class=\"accordion-content{{#unless start_collapsed}} is-open{{/unless}}\">\n\n        {{#if type '===' 'bool'}}\n            <ul id=\"facetedSearch-navList--{{dashcase facet}}\" data-facet=\"{{facet}}\" data-facet-key=\"{{dashcase facet}}\" class=\"navList\" data-has-more-results=\"{{has_more_results}}\">\n                {{#each items}}\n                    <li class=\"navList-item\">\n                        <a\n                            href=\"{{url}}\"\n                            class=\"navList-action navList-action--checkbox{{#if selected}} is-selected{{/if}}\"\n                            rel=\"nofollow\"\n                            data-id=\"{{id}}\"\n                            data-faceted-search-facet>\n                            {{{sanitize title}}}\n                            {{#if ../show_product_counts}}\n                                <span class=\"_count\">({{count}})</span>\n                            {{/if}}\n\n                            <span class=\"navList-action-close\" aria-hidden=\"true\">\n                                <svg class=\"icon\">\n                                    <use href=\"#icon-close\"/>\n                                </svg>\n                            </span>\n                        </a>\n                    </li>\n                {{/each}}\n            </ul>\n        {{else}}\n            <ul id=\"facetedSearch-navList--{{dashcase facet}}\" data-facet=\"{{facet}}\" class=\"eyeva__faceted-list\" data-has-more-results=\"{{has_more_results}}\">\n                {{#each items}}\n                    <li class=\"eyeva__faceted-list-item\">\n                        <a\n                            href=\"{{url}}\"\n                            class=\"eyeva__faceted-list-action{{#if selected}} is-selected{{/if}}\"\n                            rel=\"nofollow\"\n                            data-id=\"{{id}}\"\n                            data-faceted-search-facet>\n                            {{#if ../isFacetImg}}\n                                <span class=\"_img\" data-faceted-search-facet-image>\n                                    <img\n                                        src=\"data:image/gif;base64,R0lGODlhAQABAIAAAP///wAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw==\"\n                                        data-src=\"{{getImageManagerImage (multiConcat (dashcase ../facet) '-' (dashcase id) '.png') width=(getVar 'facet_img_size_width')}}\"\n                                        data-srcset=\"{{getImageManagerImageSrcset (multiConcat (dashcase ../facet) '-' (dashcase id) '.png')}}\"\n                                        data-sizes=\"auto\"\n                                        alt=\"{{{sanitize title}}}\">\n                                </span>\n                            {{else if ../isFacetColor}}\n                                <span class=\"_color\" data-faceted-search-facet-color>\n                                    <img\n                                        src=\"data:image/gif;base64,R0lGODlhAQABAIAAAP///wAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw==\"\n                                        data-src=\"{{getImageManagerImage (multiConcat (dashcase ../facet) '-' (dashcase id) '.png') width=(getVar 'facet_color_size_width')}}\"\n                                        data-srcset=\"{{getImageManagerImageSrcset (multiConcat (dashcase ../facet) '-' (dashcase id) '.png')}}\"\n                                        data-sizes=\"auto\"\n                                        alt=\"{{{sanitize title}}}\">\n                                </span>\n                            {{/if}}\n                            <span class=\"_text\">{{{sanitize title}}}</span>\n                            {{#if ../show_product_counts}}\n                                <span class=\"_count\">({{count}})</span>\n                            {{/if}}\n                        </a>\n                    </li>\n                {{/each}}\n            </ul>\n        {{/if}}\n\n        {{#if show_more_toggle}}\n            <a href=\"#facetedSearch-navList--{{dashcase facet}}\" role=\"button\" class=\"toggleLink\">\n                <span class=\"toggleLink-text toggleLink-text--off\">{{lang 'search.faceted.show-more'}}</span>\n                <span class=\"toggleLink-text toggleLink-text--on\">{{lang 'search.faceted.show-less'}}</span>\n            </a>\n        {{/if}}\n    </div>\n</div>\n{{/if}}\n",
  "components/faceted-search/faceted-search-navigation": "<h2 class=\"accordion-heading accordion-nav-clear-holder\">\n    <button type=\"button\"\n         class=\"accordion-navigation {{#unless start_collapsed}} is-open{{/unless}}\"\n         data-collapsible=\"#facetedSearch-content--{{dashcase facet}}\"\n         aria-label=\"{{lang 'search.faceted.toggleSection' title=title}}\"\n    >\n        <span class=\"_title\">\n            {{title}}\n        </span>\n\n        {{#if selected}}\n            <span class=\"_count\">1</span>\n        {{/if}}\n\n        <span class=\"icon\"><svg><use href=\"#icon-chevron-down\" /></svg></span>\n    </button>\n    {{#if selected}}\n        <a href=\"{{remove_url}}\" class=\"facetedSearch-clearLink\" data-faceted-search-facet>\n            <span class=\"is-srOnly\">{{lang 'search.faceted.clear'}}</span>\n            <span class=\"icon\"><svg><use href=\"#icon-xmark-large\" /></svg></span>\n        </a>\n    {{/if}}\n</h2>\n"
}
