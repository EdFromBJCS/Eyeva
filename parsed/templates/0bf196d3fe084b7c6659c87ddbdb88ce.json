{
  "components/common/wishlist-dropdown": "<form action=\"{{product.add_to_wishlist_url}}\" class=\"form form-wishlist form-action\" data-wishlist-add=\"{{product.id}}\" method=\"post\" data-product-name=\"{{product.title}}\">\n    {{#if customer}}\n        <a aria-controls=\"eyeva__wishlist-dropdown-{{product.id}}\"\n        aria-expanded=\"false\"\n        class=\"button-wishlist-icon\"\n        data-dropdown=\"eyeva__wishlist-dropdown--{{product.id}}\"\n        data-wishlist-add-customer\n        href=\"#eyeva__wishlist-dropdown--{{product.id}}\"\n        >\n            <span class=\"is-srOnly\">{{lang 'account.wishlists.add_item'}}</span>\n            <i aria-hidden=\"true\" class=\"icon _off\"><svg><use href=\"#icon-heart\" /></svg></i>\n            <i aria-hidden=\"true\" class=\"icon _on\"><svg><use href=\"#icon-heart-solid\" /></svg></i>\n        </a>\n        <ul aria-hidden=\"true\" class=\"wishlist-dropdown-menu\" data-dropdown-content data-dropdown-align=\"right\" id=\"eyeva__wishlist-dropdown--{{product.id}}\" data-wishlist-dropdown>\n            {{#if customer.wishlists}}\n                {{#each customer.wishlists}}\n                    <li>\n                        <button class=\"_action {{#if this.num_items '!==' '0'}}_has-items{{/if}}\"\n                            formaction=\"{{this.add_url}}&product_id={{../product.id}}\"\n                            type=\"submit\"\n                            data-wishlist-id=\"{{this.id}}\"\n                        >\n                            {{this.name}}\n                            <i aria-hidden=\"true\" class=\"icon _on\"><svg><use href=\"#icon-check\" /></svg></i>\n                        </button>\n                    </li>\n                {{/each}}\n            {{else}}\n                <li data-wishlist-add-to-default>\n                    <input class=\"_action\" type=\"submit\" value=\"{{lang 'account.wishlists.add_to_default'}}\">\n                </li>\n            {{/if}}\n            <li>\n                <a data-wishlist-create class=\"_action\" href=\"/wishlist.php?action=addwishlist&product_id={{product.id}}\">{{lang 'account.wishlists.create_new'}}</a>\n            </li>\n        </ul>\n    {{else}}\n        <button type=\"button\" class=\"button-wishlist-icon\" data-wishlist-add-anonymous>\n            <span class=\"is-srOnly\">{{lang 'account.wishlists.add_item'}}</span>\n            <i aria-hidden=\"true\" class=\"icon _off\"><svg><use href=\"#icon-heart\" /></svg></i>\n            <i aria-hidden=\"true\" class=\"icon _on\"><svg><use href=\"#icon-heart-solid\" /></svg></i>\n        </button>\n    {{/if}}\n</form>\n"
}