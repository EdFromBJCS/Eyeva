{
  "components/common/subscription-form": "<h3 class=\"eyeva__newsletter-heading\">\n    {{#and settings.show_newsletter_summary settings.newsletter_summary}}\n        {{settings.newsletter_summary}}\n    {{else}}\n        {{lang 'newsletter.subscribe'}}\n    {{/and}}\n</h3>\n<form class=\"form eyeva__newsletter-form\" action=\"{{urls.subscribe.action}}\" method=\"post\">\n    <fieldset class=\"form-fieldset\">\n        <input type=\"hidden\" name=\"action\" value=\"subscribe\">\n        <input type=\"hidden\" name=\"check\" value=\"1\">\n        <div class=\"form-prefixPostfix\">\n            <input class=\"form-input\"\n                       id=\"nl_first_name\"\n                       name=\"nl_first_name\"\n                       type=\"name\"\n                       value=\"{{customer.name}}\"\n                       placeholder=\"Your name\"\n                       aria-describedby=\"alertBox-message-text\"\n                       aria-required=\"true\"                       \n                       required\n        </div>\n    </fieldset>\n    <fieldset class=\"form-fieldset\">        \n        <div class=\"form-field\">\n            <label class=\"form-label is-srOnly\" for=\"nl_email\">{{lang 'common.email_address'}}</label>\n            <div class=\"form-prefixPostfix\">\n                <input class=\"form-input\"\n                       id=\"nl_email\"\n                       name=\"nl_email\"\n                       type=\"email\"\n                       value=\"{{customer.email}}\"\n                       placeholder=\"{{lang 'newsletter.email_placeholder'}}\"\n                       aria-describedby=\"alertBox-message-text\"\n                       aria-required=\"true\"\n                       autocomplete=\"email\"\n                       required\n                >\n        </div>\n                        <input class=\"button button--primary form-prefixPostfix-button--postfix\"\n                       type=\"submit\"\n                       value=\"{{lang 'newsletter.subscribe_submit'}}\"\n                       >\n            </div>\n    </fieldset>\n</form>\n"
}