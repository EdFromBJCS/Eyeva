{
  "components/eyeva/header/navuser-main": "<div class=\"navUser-list\">\n    <button class=\"navUser-action\" type=\"button\" data-papathemes-quick-search-toggle>\n        <i class=\"icon\"><svg><use href=\"#icon-magnifying-glass\"></use></svg></i>\n        <span class=\"is-srOnly\">{{lang 'common.search'}}</span>\n    </button>\n    {{#if customer}}\n        <a class=\"navUser-action\" href=\"{{urls.account.wishlists.all}}\">\n            <i class=\"icon\"><svg><use href=\"#icon-heart\"></use></svg></i>\n            <span class=\"is-srOnly\">{{lang 'common.wishlist'}}</span>\n        </a>\n    {{else}}\n        <button class=\"navUser-action\" type=\"button\" {{#unless customer}}data-wishlist-open{{/unless}}>\n            <i class=\"icon\"><svg><use href=\"#icon-heart\"></use></svg></i>\n            <span class=\"is-srOnly\">{{lang 'common.wishlist'}}</span>\n        </button>\n    {{/if}}\n    <a class=\"navUser-action\" type=\"button\"\n        {{#if page_type '!==' 'cart'}}\n            data-cart-drawer-toggle\n        {{/if}}\n        href=\"{{urls.cart}}\"\n        aria-label=\"{{lang 'cart.nav_aria_label'}}\"\n    >\n        <i class=\"icon\"><svg><use href=\"#icon-cart-shopping\"></use></svg></i>\n        <span class=\"countPill cart-quantity\"></span>\n    </a>\n</div>\n"
}