{
  "components/eyeva/header/navigation": "<div class=\"navPages\" id=\"navPages\">\n    {{#if theme_settings.menu_editing}}\n        {{> components/common/alert/alert-error \"Editing menu widgets. Remember to close this when finished from <b>Theme Styles</b> &gt; <b>Header and footer</b> &gt; <b>TURN ON EDITING MENU WIDGETS</b>\"}}\n    {{/if}}\n    {{#if customer}}\n        <div class=\"navPages-list _customer\">\n            <li class=\"navPages-item\">\n                {{> components/eyeva/header/navigation-account depth=1}}\n            </li>\n        </div>\n    {{/if}}\n\n    <ul class=\"navPages-list\">\n        {{#each categories}}\n            <li class=\"navPages-item\" {{#if children}}data-menu-gap-cover{{/if}}>\n                {{#if ../theme_settings.navigation_design '==' 'simple'}}\n                    {{> components/eyeva/header/navigation-mega depth=1}}\n                {{else}}\n                    {{> components/eyeva/header/navigation-list depth=1}}\n                {{/if}}\n            </li>\n        {{/each}}\n<li class=\"navPages-item\">\n                <a class=\"navPages-action\" href=\"/repairs-service/?tab=0\">Repairs &amp; Service</a>\n            </li>\n<li class=\"navPages-item _info\">\n    <a href=\"#\" class=\"navPages-action info-toggle\">\n        Info\n        <i class=\"icon navPages-action-moreIcon\" aria-hidden=\"true\">\n            <svg><use href=\"#icon-chevron-down\"></use></svg>\n        </i>\n    </a>\n</li>\n    </ul>\n\n    <ul class=\"navPages-list _webpages {{#if theme_settings.hide_content_navigation}}force-hide-desktop{{/if}}\">\n        {{#each pages}}\n            <li class=\"navPages-item\n                {{#unless ../theme_settings.hide_content_navigation}}\n                    {{#if (add @index 1) '<' (toInt ../theme_settings.webpage_start)}}\n                        force-hide-desktop\n                    {{else if (toInt ../theme_settings.webpage_limit)}}\n                        {{#if (add @index 2) '>' (add (toInt ../theme_settings.webpage_start) (toInt ../theme_settings.webpage_limit))}}\n                            force-hide-desktop\n                        {{/if}}\n                    {{/if}}\n                {{/unless}}\n                \" {{#if children}}data-menu-gap-cover{{/if}}>\n                {{#if ../theme_settings.navigation_design '==' 'simple'}}\n                    {{> components/eyeva/header/navigation-mega depth=1 is_page=true}}\n                {{else}}\n                    {{> components/eyeva/header/navigation-list  depth=1 is_page=true}}\n                {{/if}}\n            </li>\n        {{/each}}\n        {{#if settings.gift_certificates_enabled}}\n            <li class=\"navPages-item _gift {{#any theme_settings.hide_content_navigation theme_settings.hide_gift_cert}}force-hide-desktop{{/any}}\">\n                <a class=\"navPages-action _webpage\" href=\"{{urls.gift_certificate.purchase}}\" aria-label=\"{{lang 'common.gift_cert'}}\">\n                    <span class=\"navPages-label\">{{lang 'common.gift_cert'}}</span>\n                </a>\n            </li>\n        {{/if}}\n        {{#if currency_selector.currencies.length '>' 1}}\n            <li class=\"navPages-item _currency\">\n                <a class=\"navPages-action _webpage\" href=\"#\"\n                    data-collapsible=\"navPages-currency\"\n                    aria-controls=\"navPages-currency\"\n                    aria-expanded=\"false\"\n                    aria-label=\"{{lang 'common.currency' code=currency_selector.active_currency_code}}\"\n                >\n                    <span class=\"navPages-label\">{{lang 'common.currency' code=currency_selector.active_currency_code}}</span>\n                    <i class=\"icon\" aria-hidden=\"true\"><svg><use href=\"#icon-arrow-right-long\"></use></svg></i>\n                </a>\n                <div class=\"navPages-subMenu\" id=\"navPages-currency\" aria-hidden=\"true\" data-menu-dropdown>\n                    <ul class=\"navPages-childList\">\n                        <li class=\"navPages-childList-item _parent _depth-1\">\n                            <a class=\"navPages-childList-action  _parent _depth-1 _webpage\" href=\"#\"\n                                data-collapsible=\"navPages-currency\"\n                                aria-controls=\"navPages-currency\"\n                                aria-expanded=\"false\"\n                            >\n                                <i class=\"icon\" aria-hidden=\"true\"><svg><use href=\"#icon-arrow-left-long\"></use></svg></i>\n                                <span class=\"navPages-childList-label\">{{lang 'common.currency' code=currency_selector.active_currency_code}}</span>\n                            </a>\n                        </li>\n                        {{#each currency_selector.currencies}}\n                            <li class=\"navPages-childList-item\">\n                                <a class=\"navPages-childList-action {{#if is_active}} activePage{{/if}}\" href=\"{{switch_url}}\"\n                                    data-currency-code=\"{{{code}}}\"\n                                    {{#if cart_currency_switch_url.length '>' 0 }}\n                                        data-cart-currency-switch-url=\"{{{cart_currency_switch_url}}}\"\n                                    {{/if}}\n                                    data-warning=\"{{lang 'common.currency_switch_promotion'}}\"\n                                >\n                                    <span class=\"navPages-label\">{{name}}</span>\n                                </a>\n                            </li>\n                        {{/each}}\n                    </ul>\n                </div>\n            </li>\n        {{/if}}\n    </ul>\n    {{#unless customer}}\n        <div class=\"navPages-list _account\">\n            <p><span class=\"navPages-list-heading\">{{lang 'login.heading'}}</span></p>\n            <p>\n                {{lang 'login.new_customer.intro'}}\n                {{lang 'login.new_customer.fact1'}},\n                {{lang 'login.new_customer.fact2'}},\n                {{lang 'login.new_customer.fact3'}},\n                {{lang 'login.new_customer.fact4'}},\n                {{lang 'login.new_customer.fact5'}}\n            </p>\n            <p><a class=\"button button--primary\" href=\"{{urls.auth.login}}\">{{lang 'login.submit_value'}}</a></p>\n            {{#if settings.account_creation_enabled}}\n                <p>{{lang 'login.no_account'}} <a href=\"{{urls.auth.create_account}}\">{{lang 'login.sign_up'}}</a></p>\n            {{/if}}\n        </div>\n    {{/unless}}\n</div>\n",
  "components/common/alert/alert-error": "<!-- Double out of stock arlerts, removed the second one, this one\n<div class=\"alertBox alertBox--error\">\n    <div class=\"alertBox-column alertBox-icon\">\n        <icon glyph=\"ic-error\" class=\"icon\" aria-hidden=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z\"></path></svg></icon>\n    </div>\n    <p class=\"alertBox-column alertBox-message\">\n        <span id=\"alertBox-message-text\">{{{this}}}</span>\n    </p>\n</div>-->\n",
  "components/eyeva/header/navigation-mega": "{{#if children}}\r\n    {{#unless id}}\r\n        {{#if (merge this id=(concat 'page-' (incrementVar 'incrementId')))}}{{/if}}\r\n    {{/unless}}\r\n    <a class=\"navPages-action {{#if is_active}} activePage{{/if}} {{#if is_page}}_webpage{{/if}} {{#if name '==' 'Selection Assistance'}}navPages-action--autoselect{{/if}}\" href=\"{{url}}\"\r\n        data-collapsible=\"navPages-subMenu-{{id}}\"\r\n        data-collapsible-disabled-breakpoint=\"medium\"\r\n        data-collapsible-disabled-state=\"close\"\r\n        data-collapsible-enabled-state=\"close\"\r\n        aria-controls=\"navPages-subMenu-{{id}}\"\r\n        aria-expanded=\"false\"\r\n    >\r\n        <span class=\"navPages-label\">{{name}}</span>\r\n    </a>\r\n    <button class=\"navPages-subMenu-toggle _depth-{{depth}}\" type=\"button\"\r\n        data-collapsible=\"navPages-subMenu-{{id}}\"\r\n        aria-controls=\"navPages-subMenu-{{id}}\"\r\n        aria-expanded=\"false\"\r\n        aria-label=\"Toggle sub-menu\"\r\n    >\r\n        <span class=\"is-srOnly\">Toggle sub-menu</span>\r\n        <i class=\"icon hide-desktop\" aria-hidden=\"true\"><svg><use href=\"#icon-arrow-right-long\"></use></svg></i>\r\n        <i class=\"icon hide-mobile-tablet\" aria-hidden=\"true\"><svg><use href=\"#icon-chevron-down\"></use></svg></i>\r\n    </button>\r\n    <div class=\"navPages-megaMenu\" id=\"navPages-subMenu-{{id}}\" aria-hidden=\"true\" data-menu-dropdown>\r\n        <ul class=\"navPages-megaMenu-childList\">\r\n            <li class=\"navPages-childList-item _parent _mega _depth-{{depth}}\">\r\n                <a class=\"navPages-childList-action  _parent _depth-{{depth}} {{#if is_page}}_webpage{{/if}}\" href=\"{{url}}\"\r\n                    data-collapsible=\"navPages-subMenu-{{id}}\"\r\n                    aria-controls=\"navPages-subMenu-{{id}}\"\r\n                    aria-expanded=\"false\"\r\n                >\r\n                    <i class=\"icon\" aria-hidden=\"true\"><svg><use href=\"#icon-arrow-left-long\"></use></svg></i>\r\n                    <span class=\"navPages-childList-label\">{{name}}</span>\r\n                </a>\r\n            </li>\r\n            <li class=\"navPages-widgetRegion\">\r\n                {{{region name=(multiConcat \"menu_left_\" id \"--global\")}}}\r\n            </li>\r\n            {{#each children}}\r\n                <li class=\"navPages-megaMenu-column _left\">\r\n                    {{> components/eyeva/header/navigation-child-mega depth=(add ../depth 1)}}\r\n                </li>\r\n            {{/each}}\r\n            <li class=\"navPages-widgetRegion _right\">\r\n                {{{region name=(multiConcat \"menu_right_\" id \"--global\")}}}\r\n            </li>\r\n            <li class=\"navPages-widgetRegion _top\">\r\n                {{{region name=(multiConcat \"menu_top_\" id \"--global\")}}}\r\n            </li>\r\n        </ul>\r\n    </div>\r\n{{else}}\r\n    <a class=\"navPages-action {{#if is_active}} activePage{{/if}} {{#if is_page}}_webpage{{/if}} {{#if name '==' 'Selection Assistance'}}navPages-action--autoselect{{/if}}\" href=\"{{url}}\">\r\n        <span class=\"navPages-label\">{{name}}</span>\r\n    </a>\r\n{{/if}}\r\n",
  "components/eyeva/header/navigation-account": "<a class=\"navPages-action _webpage\" href=\"{{urls.account.index}}\"\n    data-collapsible=\"navPages-account\"\n    aria-controls=\"navPages-account\"\n    aria-expanded=\"false\"\n>\n    <span class=\"navPages-label\">{{lang 'common.account'}}</span>\n    <i class=\"icon\" aria-hidden=\"true\"><svg><use href=\"#icon-arrow-right-long\"></use></svg></i>\n</a>\n<div class=\"navPages-subMenu\" id=\"navPages-account\" aria-hidden=\"true\" data-menu-dropdown>\n    <ul class=\"navPages-childList\">\n        <li class=\"navPages-childList-item _parent _depth-{{depth}}\">\n            <a class=\"navPages-childList-action  _parent _depth-{{depth}} _webpage\" href=\"{{urls.account.index}}\"\n                data-collapsible=\"navPages-account\"\n                aria-controls=\"navPages-account\"\n                aria-expanded=\"false\"\n            >\n                <i class=\"icon\" aria-hidden=\"true\"><svg><use href=\"#icon-arrow-left-long\"></use></svg></i>\n                <span class=\"navPages-childList-label\">{{lang 'common.account'}}</span>\n            </a>\n        </li>\n        {{#if customer.store_credit.value '>' 0}}\n            <li class=\"navPages-childList-item\">\n                <a class=\"navPages-childList-action\">\n                    <span class=\"navPages-label\">{{lang 'common.store_credit_overview' credit=customer.store_credit.formatted}}</span>\n                </a>\n            </li>\n        {{/if}}\n        <li class=\"navPages-childList-item\">\n            <a class=\"navPages-childList-action\" href=\"{{urls.account.orders.all}}\">\n                <span class=\"navPages-label\">{{lang 'account.nav.orders'}}</span>\n            </a>\n        </li>\n        {{#if settings.returns_enabled}}\n            <li class=\"navPages-childList-item\">\n                <a class=\"navPages-childList-action\" href=\"{{urls.account.returns}}\">\n                    <span class=\"navPages-label\">{{lang 'account.nav.returns'}}</span>\n                </a>\n            </li>\n        {{/if}}\n        <li class=\"navPages-childList-item\">\n            <a class=\"navPages-childList-action\" href=\"{{urls.account.inbox}}\">\n                <span class=\"navPages-label\">{{lang 'account.mobile_nav.messages'}}</span>\n            </a>\n        </li>\n        <li class=\"navPages-childList-item\">\n            <a class=\"navPages-childList-action\" href=\"{{urls.account.addresses}}\">\n                <span class=\"navPages-label\">{{lang 'account.nav.addresses'}}</span>\n            </a>\n        </li>\n        {{#if settings.show_payment_methods}}\n            <li class=\"navPages-childList-item\">\n                <a class=\"navPages-childList-action\" href=\"{{urls.account.payment_methods.all}}\">\n                    <span class=\"navPages-label\">{{lang 'account.nav.payment_methods'}}</span>\n                </a>\n            </li>\n        {{/if}}\n        <li class=\"navPages-childList-item\">\n            <a class=\"navPages-childList-action\" href=\"{{urls.account.wishlists.all}}\">\n                <span class=\"navPages-label\">{{lang 'account.mobile_nav.wishlists'}}</span>\n            </a>\n        </li>\n        <li class=\"navPages-childList-item\">\n            <a class=\"navPages-childList-action\" href=\"{{urls.account.recent_items}}\">\n                <span class=\"navPages-label\">{{lang 'account.nav.recently_viewed'}}</span>\n            </a>\n        </li>\n        <li class=\"navPages-childList-item\">\n            <a class=\"navPages-childList-action\" href=\"{{urls.account.details}}\">\n                <span class=\"navPages-label\">{{lang 'account.nav.settings'}}</span>\n            </a>\n        </li>\n        <li class=\"navPages-childList-item\">\n            <a class=\"navPages-childList-action\" href=\"{{urls.auth.logout}}\">\n                <span class=\"navPages-label\">{{lang 'common.logout'}}</span>\n            </a>\n        </li>\n    </ul>\n</div>\n",
  "components/eyeva/header/navigation-list": "{{#if children}}\n    {{#unless id}}\n        {{#if (merge this id=(concat 'page-' (incrementVar 'incrementId')))}}{{/if}}\n    {{/unless}}\n    <a class=\"navPages-action {{#if is_active}} activePage{{/if}} {{#if is_page}}_webpage{{/if}} {{#if name '==' 'Selection Assistance'}}navPages-action--autoselect{{/if}}\" href=\"{{url}}\"\n        data-collapsible=\"navPages-subMenu-{{id}}\"\n        data-collapsible-disabled-breakpoint=\"medium\"\n        data-collapsible-disabled-state=\"close\"\n        data-collapsible-enabled-state=\"close\"\n        aria-controls=\"navPages-subMenu-{{id}}\"\n        aria-expanded=\"false\"\n    >\n        <span class=\"navPages-label\">{{name}}</span>\n    </a>\n    <button class=\"navPages-subMenu-toggle _depth-{{depth}}\" type=\"button\"\n        data-collapsible=\"navPages-subMenu-{{id}}\"\n        aria-controls=\"navPages-subMenu-{{id}}\"\n        aria-expanded=\"false\"\n        aria-label=\"Toggle sub-menu\"\n    >\n        <span class=\"is-srOnly\">Toggle sub-menu</span>\n        <i class=\"icon hide-desktop\" aria-hidden=\"true\"><svg><use href=\"#icon-arrow-right-long\"></use></svg></i>\n        <i class=\"icon hide-mobile-tablet\" aria-hidden=\"true\"><svg><use href=\"#icon-chevron-down\"></use></svg></i>\n    </button>\n    <div class=\"navPages-subMenu\" id=\"navPages-subMenu-{{id}}\" aria-hidden=\"true\" data-menu-dropdown>\n        <ul class=\"navPages-childList\">\n            <li class=\"navPages-childList-item _parent _depth-{{depth}}\">\n                <a class=\"navPages-childList-action  _parent _depth-{{depth}} {{#if is_page}}_webpage{{/if}}\" href=\"{{url}}\"\n                    data-collapsible=\"navPages-subMenu-{{id}}\"\n                    aria-controls=\"navPages-subMenu-{{id}}\"\n                    aria-expanded=\"false\"\n                >\n                    <i class=\"icon\" aria-hidden=\"true\"><svg><use href=\"#icon-arrow-left-long\"></use></svg></i>\n                    <span class=\"navPages-childList-label\">{{name}}</span>\n                </a>\n            </li>\n            {{#each children}}\n                <li class=\"navPages-childList-item\">\n                    {{> components/eyeva/header/navigation-child-list depth=(add ../depth 1)}}\n                </li>\n            {{/each}}\n        </ul>\n    </div>\n{{else}}\n    <a class=\"navPages-action {{#if is_active}} activePage{{/if}} {{#if is_page}}_webpage{{/if}} {{#if name '==' 'Selection Assistance'}}navPages-action--autoselect{{/if}}\" href=\"{{url}}\">\n        <span class=\"navPages-label\">{{name}}</span>\n    </a>\n{{/if}}\n",
  "components/eyeva/header/navigation-child-mega": "{{#if children}}\n    {{#unless id}}\n        {{#if (merge this id=(concat 'page-' (incrementVar 'incrementId')))}}{{/if}}\n    {{/unless}}\n    <a class=\"navPages-childList-action _mega {{#if is_active}} activePage{{/if}}\" href=\"{{url}}\">\n        <span class=\"navPages-label\">{{name}}</span>\n    </a>\n    <div class=\"navPages-megaMenu-subMenu\">\n        <ul class=\"navPages-megaMenu-childList\">\n            {{#each children}}\n                <li class=\"navPages-childList-item\">\n                    {{> components/eyeva/header/navigation-child-list depth=(add ../depth 1)}}\n                </li>\n            {{/each}}\n        </ul>\n    </div>\n{{else}}\n    <a class=\"navPages-childList-action _mega {{#if is_active}} activePage{{/if}}\" href=\"{{url}}\">\n        <span class=\"navPages-label\">{{name}}</span>\n    </a>\n{{/if}}\n",
  "components/eyeva/header/navigation-child-list": "{{#if children}}\n    {{#unless id}}\n        {{#if (merge this id=(concat 'page-' (incrementVar 'incrementId')))}}{{/if}}\n    {{/unless}}\n    <a class=\"navPages-childList-action {{#if is_active}} activePage{{/if}}\" href=\"{{url}}\"\n        data-collapsible=\"navPages-subMenu-{{id}}\"\n        data-collapsible-disabled-breakpoint=\"medium\"\n        data-collapsible-disabled-state=\"closed\"\n        data-collapsible-enabled-state=\"closed\"\n        aria-controls=\"navPages-subMenu-{{id}}\"\n        aria-expanded=\"false\"\n    >\n        <span class=\"navPages-label\">{{name}}</span>\n    </a>\n    <button class=\"navPages-subMenu-toggle _depth-{{depth}}\" type=\"button\"\n        data-collapsible=\"navPages-subMenu-{{id}}\"\n        aria-controls=\"navPages-subMenu-{{id}}\"\n        aria-expanded=\"false\"\n        aria-label=\"Toggle sub-menu\"\n    >\n        <span class=\"is-srOnly\">Toggle sub-menu</span>\n        <i class=\"icon\" aria-hidden=\"true\"><svg><use href=\"#icon-arrow-right-long\"></use></svg></i>\n    </button>\n    <div class=\"navPages-subMenu\" id=\"navPages-subMenu-{{id}}\" aria-hidden=\"true\">\n        <ul class=\"navPages-childList\">\n            <li class=\"navPages-childList-item _parent _depth-{{depth}}\">\n                <a class=\"navPages-childList-action _parent _depth-{{depth}}\" href=\"{{url}}\"\n                    data-collapsible=\"navPages-subMenu-{{id}}\"\n                    aria-controls=\"navPages-subMenu-{{id}}\"\n                    aria-expanded=\"false\"\n                >\n                    <i class=\"icon\" aria-hidden=\"true\"><svg><use href=\"#icon-arrow-left-long\"></use></svg></i>\n                    <span class=\"navPages-childList-label\">{{name}}</span>\n                </a>\n            </li>\n            {{#each children}}\n                <li class=\"navPages-childList-item\">\n                    {{> components/eyeva/header/navigation-child-list depth=(add ../depth 1)}}\n                </li>\n            {{/each}}\n        </ul>\n    </div>\n{{else}}\n    <a class=\"navPages-childList-action{{#if is_active}} activePage{{/if}}\" href=\"{{url}}\">\n        <span class=\"navPages-label\">{{name}}</span>\n    </a>\n{{/if}}\n"
}