{
  "components/papathemes/category/tabs": "{{!--\n    Input:\n    - type (carousel/grid): Type of the best selling products section.\n    - count (number): Number of products to show.\n    - sortby (bestselling/newest): Sort type.\n    - scope (string): section scope selector. example: `.topProducts`.\n    - categories (array): List of categories.\n        - id (number): Category ID.\n        - name (string): Category name.\n        - url (string): Category URL.\n--}}\n<div class=\"categoryTabs\" data-category-tabs='{\n    \"type\": \"{{type}}\",\n    \"limit\": {{count}},\n    \"sort\": \"{{sortby}}\",\n    \"scope\": \"{{scope}}\",\n    \"container\": \".blaze-track, .productGrid\"\n}'>\n    <ul class=\"categoryTabs-list\">\n        {{#each categories}}\n            {{#if @index '>=' 3}}\n                <li class=\"categoryTabs-item force-hide-desktop\" data-category-tabs-item-hide>\n                    <a class=\"categoryTabs-link\" href=\"{{url}}\" data-category-tabs-url=\"{{url}}\" data-category-tabs-id=\"{{id}}\"><span>{{name}}</span></a>\n                </li>\n            {{else}}\n                <li class=\"categoryTabs-item\">\n                    <a class=\"categoryTabs-link\" href=\"{{url}}\" data-category-tabs-url=\"{{url}}\" data-category-tabs-id=\"{{id}}\"><span>{{name}}</span></a>\n                </li>\n            {{/if}}\n        {{/each}}\n    </ul>\n    {{#if categories.length '>' 3}}\n        <a href=\"#\" class=\"categoryTabs-link _more force-hide-mobile-tablet\"\n            data-dropdown=\"categoryTabs-dropdown-{{incrementVar 'incrementId'}}\"\n            aria-controls=\"categoryTabs-dropdown-{{getVar 'incrementId'}}\" aria-expanded=\"false\"\n        >\n            <span class=\"is-srOnly\">{{lang 'common.load_more'}}</span>\n            <i class=\"icon\" aria-hidden=\"true\"><svg><use href=\"#icon-circle-ellipsis\"></use></svg></i>\n        </a>\n        <ul class=\"categoryTabs-dropdown\" id=\"categoryTabs-dropdown-{{getVar 'incrementId'}}\" data-dropdown-content data-category-tabs-dropdown aria-hidden=\"true\"></ul>\n    {{/if}}\n</div>\n"
}