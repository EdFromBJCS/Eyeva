{
  "components/products/options/input-numbers": "<div class=\"form-field\" data-product-attribute=\"input-number\" data-product-attribute-state=\"{{state}}\" data-product-attribute-id=\"{{id}}\">\n    <label class=\"form-label form-label--alternate form-label--inlineSmall\" for=\"attribute_number_{{id}}\">\n        {{ this.display_name }}:\n\n        {{> components/common/requireness-msg}}\n    </label>\n\n    <input class=\"form-input\" type=\"number\" id=\"attribute_number_{{id}}\" {{#unless this.integer_only}}step=\"any\"{{/unless}} name=\"attribute[{{this.id}}]\" value=\"{{this.prefill}}\" {{#if required}}required{{/if}}>\n</div>\n",
  "components/common/requireness-msg": "<small>\n    {{#if required}}\n    <span class=\"_required\">({{lang 'common.required'}})</span>\n    {{else}}\n    <span class=\"_optional\">{{lang 'common.optional'}}</span>\n    {{/if}}\n</small>\n"
}
