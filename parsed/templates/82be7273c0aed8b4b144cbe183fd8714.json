{
  "components/eyeva/home-brands": "<div class=\"section section--brands\">\n    <div class=\"brandCarousel\">\n        <div class=\"section-header-wrapper\">\n            <h2 class=\"section-heading\">{{lang 'home.featured_brands'}}</h2>\n            <a href=\"{{urls.brands}}\" class=\"button button--outline brandCarousel-more\">\n                {{lang 'brand.more_brands'}}\n                <i class=\"icon\" aria-hidden=\"true\"><svg><use href=\"#icon-arrow-right-long\"></use></svg></i>\n            </a>\n        </div>\n\n        <div class=\"brandCarousel-container\" data-brand-carousel-container>\n            <div class=\"brandCarousel-list _style-{{theme_settings.home_brands_style}}\" data-brand-carousel>\n                {{#each brands}}\n                    <div class=\"brandCarousel-item\" data-brand-carousel-id=\"{{id}}\">\n                        <a href=\"{{url}}\" class=\"brandCarousel-link\">\n                            <div class=\"brandCarousel-image-container\" data-brand-image-container>\n                                <span class=\"brandCarousel-name\">{{name}}</span>\n                            </div>\n                            {{#if ../theme_settings.home_brands_style '==' 'sofas'}}\n                                <span class=\"brandCarousel-name-alt\">{{name}}</span>\n                            {{/if}}\n                        </a>\n                    </div>\n                {{/each}}\n                <div class=\"brandCarousel-item\">\n                    <a href=\"{{urls.brands}}\" class=\"brandCarousel-link\">\n                        <div class=\"brandCarousel-image-container\">\n                            <span class=\"brandCarousel-name\">{{lang 'brand.more_brands'}}...</span>\n                        </div>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n"
}