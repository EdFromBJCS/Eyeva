{
  "components/products/description": "<div class=\"inventory-specs-btn-container\">\n    <a href=\"https://www.bobjohnson.com/blog/real-honest-photos-of-real-honest-toughbooks/\" class=\"button button--outline picturesActualInventory\" target=\"_blank\">Pictures Of Actual Inventory! Learn More Here!</a>\n    <a href=\"#website-specifications\" class=\"button button--primary\" id=\"skipToSpecs\">Skip To Specs</a>\n</div>\n{{#unless quickview}}\n    {{#if product.description}}\n        <p class=\"productView-collapsible-title\">\n            <button class=\"button button--plain _animation-on {{#unless theme_settings.collapse_description}}is-open{{/unless}}\" data-collapsible=\"productView-collapsible-description-{{product.id}}\" type=\"button\" aria-expanded=\"{{#if theme_settings.collapse_description}}false{{else}}true{{/if}}\" aria-controls=\"productView-collapsible-description-{{product.id}}\">\n                <span>{{lang 'products.description'}}</span>\n                <i class=\"icon\" aria-hidden=\"true\"><svg><use href=\"#icon-chevron-down-light\"></use></svg></i>\n            </button>\n        </p>\n        <div class=\"productView-collapsible-content _description {{#unless theme_settings.collapse_description}}is-open{{/unless}}\" id=\"productView-collapsible-description-{{product.id}}\" aria-hidden=\"{{#if theme_settings.collapse_description}}true{{else}}false{{/if}}\" data-event-type=\"product\">\n            {{{product.description}}}\n            {{#if in_development}}\n                {{#unless product.description}}\n                    <p>Demo content visible for localhost development only: <code>templates/components/eyeva/products/demo-product-description.html</code></p>\n                    {{> components/eyeva/products/demo-product-description}}\n                {{/unless}}\n            {{/if}}\n        </div>\n    {{/if}}\n{{/unless}}\n\n{{#all product.custom_fields theme_settings.show_custom_fields_tabs}}\n    <div class=\"productView-customFields\" id=\"productView-customFields-{{product.id}}\">\n        <p class=\"productView-collapsible-title\">\n            <button class=\"button button--plain _animation-on {{#unless theme_settings.collapse_custom_fields}}is-open{{/unless}}\" data-collapsible=\"productView-collapsible-customFields-{{product.id}}\" type=\"button\" aria-expanded=\"{{#if theme_settings.collapse_custom_fields}}false{{else}}true{{/if}}\" aria-controls=\"productView-collapsible-customFields-{{product.id}}\">\n                <span id=\"website-specifications\">Base Specifications</span>\n                <i class=\"icon\" aria-hidden=\"true\"><svg><use href=\"#icon-chevron-down-light\"></use></svg></i>\n            </button>\n        </p>\n        <div class=\"productView-collapsible-content _customFields {{#unless theme_settings.collapse_custom_fields}}is-open{{/unless}}\" id=\"productView-collapsible-customFields-{{product.id}}\" aria-hidden=\"{{#if theme_settings.collapse_custom_fields}}true{{else}}false{{/if}}\">\n            <dl class=\"productView-info\">\n                {{> components/products/custom-fields}}\n            </dl>\n        </div>\n    </div>\n    {{#unless product._visible_custom_fields_count}}\n        <script nonce=\"{{nonce}}\">document.getElementById('productView-customFields-{{product.id}}').style=\"display:none\";</script>\n    {{/unless}}\n{{/all}}\n{{#unless quickview}}\n    {{#if product.warranty}}\n        <p class=\"productView-collapsible-title\">\n            <button class=\"button button--plain _animation-on {{#unless theme_settings.collapse_warranty}}is-open{{/unless}}\" data-collapsible=\"productView-collapsible-warranty-{{product.id}}\" type=\"button\" aria-expanded=\"{{#if theme_settings.collapse_warranty}}false{{else}}true{{/if}}\" aria-controls=\"productView-collapsible-warranty-{{product.id}}\">\n                <span>{{lang 'products.warranty'}}</span>\n                <i class=\"icon\" aria-hidden=\"true\"><svg><use href=\"#icon-chevron-down-light\"></use></svg></i>\n            </button>\n        </p>\n        <div class=\"productView-collapsible-content _warranty {{#unless theme_settings.collapse_warranty}}is-open{{/unless}}\" id=\"productView-collapsible-warranty-{{product.id}}\" aria-hidden=\"{{#if theme_settings.collapse_warranty}}true{{else}}false{{/if}}\">\n            {{{product.warranty}}}\n        </div>\n    {{/if}}\n{{/unless}}\n<script>\n    //Hides the \"Skip To Specs button if there is no specifications section\"\ndocument.addEventListener(\"DOMContentLoaded\", function() {\n    var specsSection = document.getElementById(\"website-specifications\");\n    var skipButton = document.getElementById(\"skipToSpecs\");\n\n    if (specsSection && skipButton) {\n        skipButton.style.display = \"block\";\n\n        skipButton.addEventListener(\"click\", function(e) {\n            e.preventDefault();\n            specsSection.scrollIntoView({ behavior: \"smooth\" });\n        });\n    } else if (skipButton) {\n        skipButton.style.display = \"none\";\n    }\n});\n\n//Checks to see if the products are new so that the \"Pictures Of Actual Inventory! Learn More Here!\" link hides on new products\ndocument.addEventListener(\"DOMContentLoaded\", function() {\n    var picturesLink = document.querySelector(\".picturesActualInventory\");\n    if (!picturesLink) return;\n\n    var dtElements = document.querySelectorAll(\".productView-info dt\");\n\n    dtElements.forEach(function(dt) {\n        var dtText = dt.textContent.trim().toLowerCase();\n\n        if (dtText.includes(\"condition\")) {\n            var dd = dt.nextElementSibling;\n            if (dd) {\n                var conditionText = dd.textContent.trim().toLowerCase();\n\n                if (conditionText === \"new\") {\n                    picturesLink.style.display = \"none\";\n                } else {\n                    picturesLink.style.display = \"block\";\n                }\n            }\n        }\n    });\n});\n\n</script>",
  "components/eyeva/products/demo-product-description": "<!-- Main container for this style/demo -->\n<div class=\"eyeva-style\">\n\n    <!-- Collapsible Section: Everything Included -->\n    <h2 data-collapsible=\"everything-included\">Everything included</h2>\n\n    <!-- Content block that collapses/expands based on data-collapsible -->\n    <div id=\"everything-included\">\n\n        <!-- Short intro text about additional lens types -->\n        <p class=\"mb-0\">\n            We also offer progressive, blue-light-filtering, and anti-fatigue lenses—plus more!\n        </p>\n        <p>\n            <a href=\"#\"><strong>View all lens types</strong></a>\n        </p>\n\n        <!-- A bordered, rounded container listing key features (flex-column + gap for spacing) -->\n        <div class=\"border border-radius p-24 flex-column gap-24 des-mb-0\">\n            <!-- Each \"feature\" is a flex row with some spacing between columns -->\n            <div class=\"flex column-gap-16\">\n                <div class=\"shrink-0\">\n                    <img data-src=\"https://via.placeholder.com/50x50\" width=\"50\" height=\"50\"\n                         class=\"lazyload\" alt=\"\">\n                </div>\n                <div class=\"span-1\">\n                    <p class=\"font-18 font-16-md\"><strong>Single-vision prescriptions</strong></p>\n                    <p class=\"color-secondary font-14-md\">Also choose readers or non-prescription lenses.</p>\n                </div>\n            </div>\n\n            <div class=\"flex column-gap-16\">\n                <div class=\"shrink-0\">\n                    <img data-src=\"https://via.placeholder.com/50x50\" width=\"50\" height=\"50\"\n                         class=\"lazyload\" alt=\"\">\n                </div>\n                <div class=\"span-1\">\n                    <p class=\"font-18 font-16-md\"><strong>Polycarbonate lenses</strong></p>\n                    <p class=\"color-secondary font-14-md\">The most impact-resistant lens material for glasses</p>\n                </div>\n            </div>\n\n            <div class=\"flex column-gap-16\">\n                <div class=\"shrink-0\">\n                    <img data-src=\"https://via.placeholder.com/50x50\" width=\"50\" height=\"50\"\n                         class=\"lazyload\" alt=\"\">\n                </div>\n                <div class=\"span-1\">\n                    <p class=\"font-18 font-16-md\"><strong>Anti-reflective and scratch-resistant lens coatings</strong></p>\n                    <p class=\"color-secondary font-14-md\">And our lenses block 100% of UV rays :-)</p>\n                </div>\n            </div>\n\n            <div class=\"flex column-gap-16\">\n                <div class=\"shrink-0\">\n                    <img data-src=\"https://via.placeholder.com/50x50\" width=\"50\" height=\"50\"\n                         class=\"lazyload\" alt=\"\">\n                </div>\n                <div class=\"span-1\">\n                    <p class=\"font-18 font-16-md\"><strong>Free shipping</strong></p>\n                    <p class=\"color-secondary font-14-md\">On every single order at PapaThemes</p>\n                </div>\n            </div>\n\n            <div class=\"flex column-gap-16\">\n                <div class=\"shrink-0\">\n                    <img data-src=\"https://via.placeholder.com/50x50\" width=\"50\" height=\"50\"\n                         class=\"lazyload\" alt=\"\">\n                </div>\n                <div class=\"span-1\">\n                    <p class=\"font-18 font-16-md\"><strong>Free returns or exchanges</strong></p>\n                    <p class=\"color-secondary font-14-md\">Within 30 days of purchase</p>\n                </div>\n            </div>\n\n            <div class=\"flex column-gap-16\">\n                <div class=\"shrink-0\">\n                    <img data-src=\"https://via.placeholder.com/50x50\" width=\"50\" height=\"50\"\n                         class=\"lazyload\" alt=\"\">\n                </div>\n                <div >\n                    <p class=\"font-18 font-16-md\"><strong>Free scratched lens replacement</strong></p>\n                    <p class=\"color-secondary font-14-md\">\n                        Guaranteed for prescription lenses within six months of purchase\n                    </p>\n                </div>\n            </div>\n\n            <div class=\"flex column-gap-16\">\n                <div class=\"shrink-0\">\n                    <img data-src=\"https://via.placeholder.com/50x50\" width=\"50\" height=\"50\"\n                         class=\"lazyload\" alt=\"\">\n                </div>\n                <div class=\"span-1\">\n                    <p class=\"font-18 font-16-md\"><strong>FSA, HSA, and insurance accepted</strong></p>\n                    <p class=\"color-secondary font-14-md\">Save an average of $100 when you use insurance</p>\n                </div>\n            </div>\n\n            <!-- Horizontal rule within the \"everything included\" section -->\n            <hr class=\"m-0\">\n\n            <!-- Another feature row with an image and description -->\n            <div class=\"flex gap-24\">\n                <div class=\"span-1\">\n                    <img data-src=\"https://via.placeholder.com/466x200\" width=\"466\" height=\"200\"\n                         class=\"lazyload\" alt=\"\">\n                </div>\n                <div class=\"span-1\">\n                    <p class=\"font-18 font-16-md\"><strong>Plus a frame case and lens cloth</strong></p>\n                    <p class=\"color-secondary font-14-md\">A frame this special deserves a comfy home to keep it safe and clean.</p>\n                </div>\n            </div>\n        </div>\n    </div><!-- /#everything-included -->\n\n    <!-- Horizontal rule separating sections -->\n    <hr>\n\n    <!-- Collapsible Section: Materials -->\n    <h2 data-collapsible=\"materials\">Materials</h2>\n    <div id=\"materials\">\n        <ul>\n            <li>Made from hand-polished cellulose acetate</li>\n        </ul>\n    </div>\n\n    <!-- Collapsible Section: Width Guide -->\n    <h2 data-collapsible=\"width-guide\">Width guide</h2>\n    <div id=\"width-guide\">\n        <p class=\"mb-0\">\n            We also offer progressive, blue-light-filtering, and anti-fatigue lenses—plus more!\n        </p>\n        <p><a href=\"#\"><strong>View all lens types</strong></a></p>\n\n        <!-- Bordered container for the width guide info -->\n        <div class=\"border border-radius mb-16 des-mb-0\">\n\n            <!-- Row with image and text, using .flex for layout -->\n            <div class=\"flex p-24 gap-24\">\n                <div class=\"shrink-0\">\n                    <img data-src=\"https://via.placeholder.com/180x100\" width=\"180\" height=\"100\"\n                         class=\"lazyload\" alt=\"\">\n                </div>\n                <div class=\"span-1\">\n                    <p class=\"font-18 font-16-md\"><strong>Frame widths</strong></p>\n                    <p class=\"color-secondary font-14-md\">\n                        Our widths are determined by the overall frame width. Choose a width that best corresponds\n                        with your own face. (You won’t find this number on glasses.)\n                    </p>\n                </div>\n            </div>\n\n            <!-- A filler line and text about the \"Medium\" size -->\n            <div class=\"fill-alt py-12 px-16 border-y\">Medium</div>\n            <div class=\"py-12 px-16\">137mm</div>\n        </div><!-- /.border-radius -->\n\n        <p><a href=\"#\" data-collapsible=\"other-measurements\">Other measurements</a></p>\n\n        <!-- Another collapsible area for other measurements -->\n        <div class=\"border border-radius mb-16 des-mb-0\" id=\"other-measurements\">\n            <div class=\"flex flex-column-md p-24 gap-24\">\n                <div class=\"shrink-0 shrink-1-md\">\n                    <img data-src=\"https://via.placeholder.com/180x100\" width=\"180\" height=\"100\"\n                         class=\"lazyload\" alt=\"\">\n                </div>\n                <div class=\"span-1\">\n                    <p class=\"font-18 font-16-md\"><strong>Compare <code>lens width</code> with <code>bridge - temple length</code> with your glasses</strong></p>\n                    <p class=\"color-secondary font-14-md\">\n                        For most glasses, these measurements are found on the inside of the temple arm.\n                        If you have a pair you like, compare it to these measurements.\n                    </p>\n                    <p class=\"mb-16\">\n                        <a href=\"#\" data-collapsible=\"what-do-these-measurements-mean\">What do these measurements mean?</a>\n                    </p>\n\n                    <!-- Additional info block with some background shading -->\n                    <div class=\"fill-alt border-radius p-16 flex-column gap-24\">\n                        <!-- Repeating features, each with an image and a short description -->\n                        <div class=\"flex gap-24\">\n                            <div class=\"shrink-0\">\n                                <img data-src=\"https://via.placeholder.com/100x60\" width=\"100\"\n                                     height=\"60\" class=\"lazyload\" alt=\"\">\n                            </div>\n                            <div class=\"span-1\">\n                                <p><strong>Lens width</strong></p>\n                                <p class=\"color-secondary font-14-md\">\n                                    The horizontal diameter of one lens (and the first measurement in the series)\n                                </p>\n                            </div>\n                        </div>\n\n                        <div class=\"flex gap-24\">\n                            <div class=\"shrink-0\">\n                                <img data-src=\"https://via.placeholder.com/100x60\" width=\"100\"\n                                     height=\"60\" class=\"lazyload\" alt=\"\">\n                            </div>\n                            <div class=\"span-1\">\n                                <p><strong>Bridge</strong></p>\n                                <p class=\"color-secondary font-14-md\">\n                                    The width of the bridge (and the second measurement in the series)\n                                </p>\n                            </div>\n                        </div>\n\n                        <div class=\"flex gap-24\">\n                            <div class=\"shrink-0\">\n                                <img data-src=\"https://via.placeholder.com/100x60\" width=\"100\"\n                                     height=\"60\" class=\"lazyload\" alt=\"\">\n                            </div>\n                            <div class=\"span-1\">\n                                <p><strong>Temple length</strong></p>\n                                <p class=\"color-secondary font-14-md\">\n                                    The length of the entire temple arm, from the front to the tip\n                                    (and the last measurement)\n                                </p>\n                            </div>\n                        </div>\n                    </div><!-- /.fill-alt -->\n                </div><!-- /.span-1 -->\n            </div><!-- /.flex -->\n\n            <!-- A row showing column headers for lens width, bridge, temple length -->\n            <div class=\"fill-alt flex child-span-1 border-y color-secondary font-14-md\">\n                <div class=\"py-12 px-16\"></div>\n                <div class=\"py-12 px-16 border-left\">Lens width</div>\n                <div class=\"py-12 px-16 border-left\">Bridge</div>\n                <div class=\"py-12 px-16 border-left\">Temple length</div>\n            </div>\n\n            <!-- A row with actual measurements for \"Medium\" frame sizing -->\n            <div class=\"flex child-span-1 font-14-md\">\n                <div class=\"fill-alt py-12 px-16 color-secondary\">Medium</div>\n                <div class=\"py-12 px-16 border-left\">50mm</div>\n                <div class=\"py-12 px-16 border-left\">20mm</div>\n                <div class=\"py-12 px-16 border-left\">140mm</div>\n            </div>\n        </div><!-- /#other-measurements -->\n\n        <!-- A horizontal flex container with a bold heading and a button link -->\n        <div class=\"flex flex-column-md border border-radius p-24 gap-24 align-items-center align-items-start-md des-mb-0\">\n            <div class=\"span-1\">\n                <strong class=\"font-18 font-16-md\">Don't have a pair of glasses?</strong>\n            </div>\n            <div class=\"shrink-0\">\n                <a href=\"#\" class=\"button button--outline\">\n                    Measure using a credit card\n                </a>\n            </div>\n        </div>\n\n        <!-- Section: Prescription and lens types offered -->\n        <h2 data-collapsible=\"prescription-and-lens-types-offered\">Prescription and lens types offered</h2>\n\n        <div id=\"prescription-and-lens-types-offered\">\n            <p>\n                <a href=\"#\" class=\"button button--outline mb-0\">Learn more in our lens guide</a>\n            </p>\n\n            <!-- \"Prescription type\" table-like layout -->\n            <div class=\"flex flex-column-md border border-radius mb-16\">\n                <div class=\"span-1 p-24\">\n                    <strong class=\"font-18 font-16-md\">Prescription type</strong>\n                </div>\n                <div class=\"span-2 flex-column border-left font-14-md\">\n                    <!-- Header row with fill-alt background and two columns -->\n                    <div class=\"flex child-py-12 child-px-16\">\n                        <div class=\"span-1 fill-alt\"></div>\n                        <div class=\"span-1 fill-alt border-left\">Starting price</div>\n                    </div>\n                    <!-- Progressive listing row -->\n                    <div class=\"flex child-py-12 child-px-16 border-top\">\n                        <div class=\"span-1 fill-alt\">Single-vision</div>\n                        <div class=\"span-1 border-left\">\n                            <s>$95</s> <strong>$80.75</strong>\n                        </div>\n                    </div>\n                    <div class=\"flex child-py-12 child-px-16 border-top\">\n                        <div class=\"span-1 fill-alt\">Progressive</div>\n                        <div class=\"span-1 border-left\">\n                            <s>$295</s> <strong>$250.75</strong>\n                        </div>\n                    </div>\n                    <div class=\"flex child-py-12 child-px-16 border-top\">\n                        <div class=\"span-1 fill-alt\">Readers</div>\n                        <div class=\"span-1 border-left\">\n                            <s>$95</s> <strong>$80.75</strong>\n                        </div>\n                    </div>\n                    <div class=\"flex child-py-12 child-px-16 border-top\">\n                        <div class=\"span-1 fill-alt\">Non-prescription</div>\n                        <div class=\"span-1 border-left\">\n                            <s>$95</s> <strong>$80.75</strong>\n                        </div>\n                    </div>\n                </div>\n            </div><!-- /.flex border -->\n\n            <!-- \"Lens type\" table-like layout -->\n            <div class=\"flex flex-column-md border border-radius mb-16\">\n                <!-- Left label column -->\n                <div class=\"span-1 p-24\">\n                    <strong class=\"font-18 font-16-md\">Lens type</strong>\n                </div>\n                <!-- Right column with stacked rows -->\n                <div class=\"span-2 flex-column border-left font-14-md\">\n\n                    <!-- Header row with two columns, second has border-left -->\n                    <div class=\"flex child-py-12 child-px-16\">\n                        <div class=\"span-1 fill-alt\"></div>\n                        <div class=\"span-1 fill-alt border-left\">Additional cost</div>\n                    </div>\n\n                    <!-- Each subsequent row has border-top and two columns -->\n                    <div class=\"flex child-py-12 child-px-16 border-top\">\n                        <div class=\"span-1 fill-alt\">Classic</div>\n                        <div class=\"span-1 border-left\">Free</div>\n                    </div>\n                    <div class=\"flex child-py-12 child-px-16 border-top\">\n                        <div class=\"span-1 fill-alt\">Blue-light filtering</div>\n                        <div class=\"span-1 border-left\">\n                            <s>$50</s> <strong>$42.50</strong>\n                        </div>\n                    </div>\n                    <div class=\"flex child-py-12 child-px-16 border-top\">\n                        <div class=\"span-1 fill-alt\">Anti-fatigue</div>\n                        <div class=\"span-1 border-left\">\n                            <s>$50</s> <strong>$42.50</strong>\n                        </div>\n                    </div>\n                    <div class=\"flex child-py-12 child-px-16 border-top\">\n                        <div class=\"span-1 fill-alt\">Light-responsive</div>\n                        <div class=\"span-1 border-left\">\n                            <s>$100</s> <strong>$85</strong>\n                        </div>\n                    </div>\n                </div><!-- /.span-2.flex-column -->\n            </div><!-- /Lens type block -->\n\n            <!-- \"Lens material\" table-like layout -->\n            <div class=\"flex flex-column-md border border-radius\">\n                <!-- Left column for title -->\n                <div class=\"span-1 p-24\">\n                    <strong class=\"font-18 font-16-md\">Lens material</strong>\n                </div>\n                <!-- Right column with stacked rows -->\n                <div class=\"span-2 flex-column border-left font-14-md\">\n                    <!-- Header row -->\n                    <div class=\"flex child-py-12 child-px-16\">\n                        <div class=\"span-1 fill-alt\"></div>\n                        <div class=\"span-1 fill-alt border-left\">Additional cost</div>\n                    </div>\n                    <!-- Material row: Polycarbonate -->\n                    <div class=\"flex child-py-12 child-px-16 border-top\">\n                        <div class=\"span-1 fill-alt\">Polycarbonate</div>\n                        <div class=\"span-1 border-left\">Free</div>\n                    </div>\n                    <!-- Material row: 1.67 high-index -->\n                    <div class=\"flex child-py-12 child-px-16 border-top\">\n                        <div class=\"span-1 fill-alt\">1.67 high-index</div>\n                        <div class=\"span-1 border-left\">\n                            <s>$50</s> <strong>$42.50</strong>\n                        </div>\n                    </div>\n                </div><!-- /.span-2.flex-column -->\n            </div><!-- /Lens material block -->\n        </div><!-- /#prescription-and-lens-types-offered -->\n    </div><!-- /#width-guide -->\n\n    <!-- Collapsible Section: Need a Prescription? -->\n    <h2 data-collapsible=\"need-a-prescription\">Need a prescription?</h2>\n    <div id=\"need-a-prescription\">\n\n        <!-- Option #1: In-person eye exam -->\n        <div class=\"border border-radius p-24 flex gap-24 mb-16\">\n            <div class=\"shrink-0\">\n                <img data-src=\"https://via.placeholder.com/160x160\" width=\"160\" height=\"160\"\n                     class=\"lazyload\" alt=\"\">\n            </div>\n            <div class=\"span-1\">\n                <p class=\"font-18 font-16-md mb-0\"><strong>Book an in-person eye exam</strong></p>\n                <p class=\"color-secondary font-14-md\">\n                    Meet with an eye doctor at one of our stores for a new prescription\n                    and eye health check.\n                </p>\n                <a href=\"#\" class=\"button button--outline\">Schedule an exam</a>\n            </div>\n        </div>\n\n        <!-- Option #2: Renew at home -->\n        <div class=\"border border-radius p-24 flex gap-24 mb-16\">\n            <div class=\"shrink-0\">\n                <img data-src=\"https://via.placeholder.com/160x160\" width=\"160\" height=\"160\"\n                     class=\"lazyload\" alt=\"\">\n            </div>\n            <div class=\"span-1\">\n                <p class=\"font-18 font-16-md mb-0\"><strong>Renew your prescription at home</strong></p>\n                <p class=\"color-secondary font-14-md\">\n                    If your vision hasn't changed, use Virtual Vision Test on an iPhone\n                    to renew your prescription from home.\n                </p>\n                <a href=\"#\" class=\"button button--outline\">Renew your prescription</a>\n            </div>\n        </div>\n\n        <!-- Already have a prescription? -->\n        <p class=\"font-18 font-16-md mb-0\">\n            <strong>Already have a non-expired prescription?</strong>\n        </p>\n        <p class=\"color-secondary font-14-md\">\n            During checkout, you'll be able to upload it, have us contact your doctor to retrieve it,\n            or send it after you place your order.\n        </p>\n    </div><!-- /#need-a-prescription -->\n</div><!-- /.eyeva-style -->\n",
  "components/products/custom-fields": "{{> components/eyeva/products/custom-fields}}\n",
  "components/eyeva/products/custom-fields": "{{#each product.custom_fields}}\n    {{#startsWith '__' name}}\n    {{else}}\n        <dt class=\"productView-info-name\">{{name}}:</dt>\n        <dd class=\"productView-info-value\">{{{value}}}</dd>\n        {{#if (merge ../product _visible_custom_fields_count=(add (default ../product._visible_custom_fields_count 0) 1))}}{{/if}}\n    {{/startsWith}}\n{{/each}}\n"
}